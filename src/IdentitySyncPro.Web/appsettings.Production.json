{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=IdentitySyncProDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=120"
  },
  "SyncSettings": {
    "DefaultBatchSize": 1000,
    "SqlCommandTimeoutSeconds": 180,
    "LdapTimeoutSeconds": 0,
    "FullSyncSchedule": "0 2 * * *",
    "DeltaSyncSchedule": "*/30 * * * *",
    "HealthCheckSchedule": "*/10 * * * *",
    "EnableAutoSync": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning",
        "IdentitySyncPro": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identitysync-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identitysync-json-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiSecurity": {
    "ApiKey": "GENERATE-A-STRONG-API-KEY-HERE",
    "HangfireApiKey": "GENERATE-A-STRONG-HANGFIRE-KEY-HERE"
  },
  "Security": {
    "IdleTimeoutMinutes": 10,
    "RequireHttpsCookie": true,
    "EnableSecurityHeaders": true,
    "ContentSecurityPolicyReportOnly": false,
    "CspExtraHosts": "",
    "PasswordMaxAgeDays": 90,
    "DefaultAdminUsername": "isp-admin",
    "DefaultAdminPassword": ""
  },
  "AllowedHosts": "*"
}
