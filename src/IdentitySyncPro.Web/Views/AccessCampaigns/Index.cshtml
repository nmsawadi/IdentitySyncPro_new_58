@model List<IdentitySyncPro.Core.Models.Governance.GovCampaign>
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "حملات المراجعة" : "Certification Campaigns";
    var progress = ViewBag.Progress as Dictionary<int, object> ?? new();
    var problems = ViewBag.Problems as Dictionary<int, string?> ?? new();

    (string Cls, string Text) State(string s) => s switch
    {
        "Draft"  => ("badge-secondary", isAr ? "مسودّة" : "Draft"),
        "Active" => ("badge-success",   isAr ? "جارية" : "Running"),
        "Closed" => ("badge-info",      isAr ? "مُغلقة" : "Closed"),
        _        => ("badge-secondary", s)
    };
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-700 mb-1"><i class="bi bi-clipboard-data-fill me-2 text-accent"></i>@(isAr ? "حملات المراجعة" : "Certification Campaigns")</h5>
        <p class="text-muted fs-sm mb-0">
            @(isAr ? "مراجعة دورية لمن يملك ماذا — بقرار مسجَّل وتنفيذ فعلي" : "Periodic review of who holds what — recorded and carried out")
        </p>
    </div>
    <a href="@Url.Action("Edit")" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i>@(isAr ? "حملة جديدة" : "New campaign")</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-clipboard-plus fs-1 text-muted d-block mb-3"></i>
        <p class="text-muted mb-3">@(isAr ? "لا حملات بعد." : "No campaigns yet.")</p>
        <a href="@Url.Action("Edit")" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i>@(isAr ? "حملة جديدة" : "New campaign")</a>
    </div>
}
else
{
    <div class="glass-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@(isAr ? "الحملة" : "Campaign")</th>
                        <th>@(isAr ? "الحالة" : "State")</th>
                        <th>@(isAr ? "التقدّم" : "Progress")</th>
                        <th>@(isAr ? "المهلة" : "Due")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    var st = State(c.Status);
                    var problem = problems.TryGetValue(c.Id, out var p) ? p : null;
                    dynamic? prog = progress.TryGetValue(c.Id, out var pr) ? pr : null;

                    <tr class="@(problem != null && c.Status == "Draft" ? "table-danger" : "")">
                        <td>
                            <div class="fw-600">@c.Name</div>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="text-muted fs-xs">@c.Description</div>
                            }
                            @* A draft that cannot be reviewed is shown as broken before it is
                               launched, because launching it schedules the revocation of everything
                               in its scope. *@
                            @if (problem != null && c.Status == "Draft")
                            {
                                <div class="text-danger fs-xs mt-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>@problem</div>
                            }
                        </td>
                        <td><span class="badge @st.Cls">@st.Text</span></td>
                        <td class="fs-xs">
                            @if (prog == null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <div>@(isAr ? "العضويات" : "items"): <strong>@prog.Total</strong></div>
                                <div>
                                    @(isAr ? "بانتظار القرار" : "pending"):
                                    <strong class="@(prog.Pending > 0 ? "text-warning" : "")">@prog.Pending</strong>
                                    · @(isAr ? "سُحبت" : "revoked"): <strong>@prog.Revoked</strong>
                                </div>
                                @if (prog.Failed > 0)
                                {
                                    <div class="text-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@prog.Failed @(isAr ? "لم تُنفَّذ في AD" : "not applied in AD")
                                    </div>
                                }
                            }
                        </td>
                        <td class="fs-xs" dir="ltr">@(c.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = c.Id })" class="btn btn-glass btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (c.Status == "Draft")
                            {
                                <a href="@Url.Action("Edit", new { id = c.Id })" class="btn btn-glass btn-sm"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
