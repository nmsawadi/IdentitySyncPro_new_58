@model List<IdentitySyncPro.Core.Models.Governance.GovAccessRequest>
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "طلبات الوصول" : "Access Requests";
    var pendingForMe = (int)(ViewBag.PendingForMe ?? 0);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="fw-700 mb-1">
            <i class="bi bi-key-fill me-2 text-accent"></i>
            @(isAr ? "طلباتي" : "My Requests")
        </h5>
        <p class="text-muted fs-sm mb-0">
            @(isAr ? "طلبات الوصول التي قدّمتها وحالتها" : "Access requests you raised, and where they stand")
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (pendingForMe > 0)
        {
            <a href="@Url.Action("Approvals")" class="btn btn-glass">
                <i class="bi bi-inbox-fill me-1"></i>
                @(isAr ? "بانتظار اعتمادي" : "Awaiting my decision")
                <span class="badge badge-warning ms-1">@pendingForMe</span>
            </a>
        }
        <a href="@Url.Action("Create")" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i>@(isAr ? "طلب وصول" : "Request access")
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <p class="text-muted mb-3">@(isAr ? "لم تقدّم أي طلب بعد." : "You have not raised any request yet.")</p>
        <a href="@Url.Action("Create")" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i>@(isAr ? "طلب وصول" : "Request access")
        </a>
    </div>
}
else
{
    <div class="glass-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@(isAr ? "الوصول المطلوب" : "Access")</th>
                        <th>@(isAr ? "للحساب" : "For account")</th>
                        <th>@(isAr ? "الحالة" : "Status")</th>
                        <th>@(isAr ? "قُدّم في" : "Raised")</th>
                        <th>@(isAr ? "مهلة القرار" : "Decision due")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-600">@(r.CatalogItem?.DisplayName ?? "—")</div>
                            <div class="text-muted fs-xs">@r.Justification</div>
                        </td>
                        <td>
                            <span dir="ltr">@r.SubjectAccount</span>
                            @if (!string.IsNullOrWhiteSpace(r.SubjectDisplayName))
                            {
                                <div class="text-muted fs-xs">@r.SubjectDisplayName</div>
                            }
                        </td>
                        <td>
                            @await Html.PartialAsync("_GovStatus", r)
                            @if (r.Status == "Approved" && r.ExecutionStatus == "Failed")
                            {
                                <div class="text-danger fs-xs mt-1">
                                    @(isAr ? "يُعاد المحاولة تلقائياً كل 15 دقيقة" : "Retried automatically every 15 minutes")
                                </div>
                            }
                        </td>
                        <td class="fs-xs" dir="ltr">@r.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fs-xs" dir="ltr">
                            @(r.DecisionDueUtc?.ToString("yyyy-MM-dd HH:mm") ?? (isAr ? "بلا مهلة" : "no deadline"))
                        </td>
                        <td class="text-end">
                            @if (r.Status == "Pending")
                            {
                                <form method="post" action="@Url.Action("Cancel")" class="d-inline"
                                      onsubmit="return confirm('@(isAr ? "سحب هذا الطلب؟" : "Withdraw this request?")');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-glass btn-sm">
                                        <i class="bi bi-slash-circle me-1"></i>@(isAr ? "سحب" : "Withdraw")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
