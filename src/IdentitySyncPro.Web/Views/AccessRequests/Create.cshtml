@using IdentitySyncPro.Core.Models.Governance
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "طلب وصول" : "Request Access";
    var catalog = ViewBag.Catalog as List<GovCatalogItem> ?? new List<GovCatalogItem>();
    var hiddenBroken = (int)(ViewBag.HiddenBroken ?? 0);
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="@Url.Action("Index")" class="btn btn-glass btn-sm"><i class="bi bi-arrow-@(isAr ? "right" : "left")"></i></a>
    <div>
        <h5 class="fw-700 mb-1"><i class="bi bi-key-fill me-2 text-accent"></i>@(isAr ? "طلب وصول" : "Request Access")</h5>
        <p class="text-muted fs-sm mb-0">
            @(isAr ? "اختر ما تحتاجه، وحدّد الحساب، واذكر السبب — يصل الطلب إلى المُعتمِد فوراً"
                   : "Pick what you need, name the account, say why — the approver is notified immediately")
        </p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!catalog.Any())
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
        <p class="text-muted mb-1">@(isAr ? "لا يوجد شيء متاح للطلب حالياً." : "There is nothing available to request.")</p>
        <p class="text-muted fs-xs mb-0">
            @(isAr ? "يضيف مدير النظام عناصر الكتالوج من «كتالوج الوصول»." : "An administrator adds entries from the Access Catalog.")
        </p>
    </div>
}
else
{
    @* An item that cannot be decided is not offered here at all. It is still counted, because a
       catalog that quietly shrinks is worse than one that says why. *@
    @if (hiddenBroken > 0)
    {
        <div class="alert alert-warning glass-card border-0 fs-xs">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @(isAr
                ? $"{hiddenBroken} عنصر في الكتالوج غير معروض لأنه غير قابل للاعتماد (بلا مُعتمِد أو بإعداد ناقص). راجعها من «كتالوج الوصول»."
                : $"{hiddenBroken} catalog entry/entries are hidden because nobody could decide them. Review them in the Access Catalog.")
        </div>
    }

    <form method="post" action="@Url.Action("Create")">
        @Html.AntiForgeryToken()
        <div class="glass-card">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@(isAr ? "الوصول المطلوب" : "Access needed") <span class="text-danger">*</span></label>
                    <select name="catalogItemId" id="catalogItem" class="form-select bg-transparent" required>
                        <option value="">@(isAr ? "— اختر —" : "— choose —")</option>
                        @foreach (var item in catalog)
                        {
                            <option value="@item.Id"
                                    data-description="@item.Description"
                                    data-group="@item.GroupName"
                                    data-duration="@item.AccessDurationDays"
                                    selected="@(ViewBag.CatalogItemId as int? == item.Id)">@item.DisplayName</option>
                        }
                    </select>
                    <div class="form-text" id="itemHelp"></div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@(isAr ? "الحساب المستفيد" : "Account it is for") <span class="text-danger">*</span></label>
                    <input type="text" name="subjectAccount" class="form-control bg-transparent" dir="ltr"
                           value="@ViewBag.SubjectAccount" placeholder="ahmed.s" required />
                    <div class="form-text">
                        @(isAr ? "اسم الدخول في AD (sAMAccountName). يُتحقق من وجوده وعضويته الحالية قبل قبول الطلب."
                               : "The AD login name. Its existence and current membership are checked before the request is accepted.")
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">@(isAr ? "المبرّر" : "Justification") <span class="text-danger">*</span></label>
                    <textarea name="justification" class="form-control bg-transparent" rows="3" required
                              placeholder="@(isAr ? "لماذا يحتاج هذا الحساب هذا الوصول؟" : "Why does this account need this access?")">@ViewBag.Justification</textarea>
                    <div class="form-text">
                        @* Said plainly, because a justification written for nobody is written badly. *@
                        @(isAr ? "يقرأه المُعتمِد الآن، ويقرأه المدقّق بعد سنة. اكتبه لهما."
                               : "The approver reads this now and an auditor reads it a year from now. Write it for both.")
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card mt-3 d-flex justify-content-between">
            <a href="@Url.Action("Index")" class="btn btn-glass">@(isAr ? "إلغاء" : "Cancel")</a>
            <button type="submit" class="btn btn-accent btn-lg">
                <i class="bi bi-send me-1"></i>@(isAr ? "تقديم الطلب" : "Submit request")
            </button>
        </div>
    </form>
}

@section Scripts {
<script>
    // What the chosen entry actually grants, and for how long — shown before submitting rather
    // than discovered in the grant email.
    (function () {
        var select = document.getElementById('catalogItem');
        var help = document.getElementById('itemHelp');
        if (!select || !help) return;

        var isAr = @(isAr ? "true" : "false");

        function describe() {
            var option = select.options[select.selectedIndex];
            if (!option || !option.value) { help.textContent = ''; return; }

            var parts = [];
            var description = option.getAttribute('data-description');
            var group = option.getAttribute('data-group');
            var duration = parseInt(option.getAttribute('data-duration') || '0', 10);

            if (description) parts.push(description);
            if (group) parts.push((isAr ? 'المجموعة: ' : 'Group: ') + group);
            parts.push(duration > 0
                ? (isAr ? ('وصول مؤقّت لمدة ' + duration + ' يوماً ثم يُسحب تلقائياً')
                        : ('Time-bound: ' + duration + ' days, then revoked automatically'))
                : (isAr ? 'وصول دائم' : 'Permanent access'));

            help.textContent = parts.join(' · ');
        }

        select.addEventListener('change', describe);
        describe();
    })();
</script>
}
