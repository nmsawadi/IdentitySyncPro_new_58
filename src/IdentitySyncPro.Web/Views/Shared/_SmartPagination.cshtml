@*
    Smart Pagination Partial View
    Usage: @await Html.PartialAsync("_SmartPagination", new ViewDataDictionary(ViewData) {
        { "PgCurrent", currentPage },
        { "PgTotal", totalPages },
        { "PgBaseUrl", Url.Action("ActionName", new { param1 = val1 }) + "&page=" }
    })
    
    Or pass query params via PgRouteValues for clean URL building.
*@
@{
    var pgCurrent = (int)(ViewData["PgCurrent"] ?? 1);
    var pgTotal = (int)(ViewData["PgTotal"] ?? 1);
    var pgBaseUrl = ViewData["PgBaseUrl"] as string ?? "?page=";
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    
    // Don't render if only one page
    if (pgTotal <= 1) { return; }
    
    // Calculate visible page range: show ±2 around current
    int rangeStart = Math.Max(1, pgCurrent - 2);
    int rangeEnd = Math.Min(pgTotal, pgCurrent + 2);
    
    // Ensure at least 5 visible pages when possible
    if (rangeEnd - rangeStart < 4)
    {
        if (rangeStart == 1)
            rangeEnd = Math.Min(pgTotal, rangeStart + 4);
        else if (rangeEnd == pgTotal)
            rangeStart = Math.Max(1, rangeEnd - 4);
    }
}

<div class="smart-pagination">
    <div class="smart-pagination-inner">
        @* First Page *@
        <a href="@(pgBaseUrl)1" 
           class="sp-btn @(pgCurrent == 1 ? "sp-disabled" : "")"
           title="@(isAr ? "الصفحة الأولى" : "First page")"
           @(pgCurrent == 1 ? "tabindex=-1 aria-disabled=true" : "")>
            <i class="bi bi-chevron-bar-@(isAr ? "right" : "left")"></i>
        </a>

        @* Previous Page *@
        <a href="@(pgBaseUrl)@(pgCurrent - 1)" 
           class="sp-btn @(pgCurrent == 1 ? "sp-disabled" : "")"
           title="@(isAr ? "الصفحة السابقة" : "Previous page")"
           @(pgCurrent == 1 ? "tabindex=-1 aria-disabled=true" : "")>
            <i class="bi bi-chevron-@(isAr ? "right" : "left")"></i>
        </a>

        @* Page Numbers *@
        <div class="sp-pages">
            @if (rangeStart > 1)
            {
                <a href="@(pgBaseUrl)1" class="sp-page">1</a>
                @if (rangeStart > 2)
                {
                    <span class="sp-ellipsis">…</span>
                }
            }

            @for (int p = rangeStart; p <= rangeEnd; p++)
            {
                <a href="@(pgBaseUrl)@p" class="sp-page @(p == pgCurrent ? "sp-active" : "")">@p</a>
            }

            @if (rangeEnd < pgTotal)
            {
                @if (rangeEnd < pgTotal - 1)
                {
                    <span class="sp-ellipsis">…</span>
                }
                <a href="@(pgBaseUrl)@pgTotal" class="sp-page">@pgTotal</a>
            }
        </div>

        @* Next Page *@
        <a href="@(pgBaseUrl)@(pgCurrent + 1)" 
           class="sp-btn @(pgCurrent == pgTotal ? "sp-disabled" : "")"
           title="@(isAr ? "الصفحة التالية" : "Next page")"
           @(pgCurrent == pgTotal ? "tabindex=-1 aria-disabled=true" : "")>
            <i class="bi bi-chevron-@(isAr ? "left" : "right")"></i>
        </a>

        @* Last Page *@
        <a href="@(pgBaseUrl)@pgTotal" 
           class="sp-btn @(pgCurrent == pgTotal ? "sp-disabled" : "")"
           title="@(isAr ? "الصفحة الأخيرة" : "Last page")"
           @(pgCurrent == pgTotal ? "tabindex=-1 aria-disabled=true" : "")>
            <i class="bi bi-chevron-bar-@(isAr ? "left" : "right")"></i>
        </a>

        @* Page Info + Jump *@
        <div class="sp-info">
            <span class="sp-info-text">
                @(isAr ? "صفحة" : "Page") <strong>@pgCurrent</strong> @(isAr ? "من" : "of") <strong>@pgTotal.ToString("N0")</strong>
            </span>
            @if (pgTotal > 10)
            {
                <div class="sp-jump">
                    <input type="number" min="1" max="@pgTotal" placeholder="@(isAr ? "انتقال" : "Go to")" 
                           class="sp-jump-input" onkeydown="if(event.key==='Enter'){var v=parseInt(this.value);if(v>=1&&v<=@pgTotal)location.href='@(pgBaseUrl)'+v;}" />
                    <button class="sp-jump-btn" onclick="var inp=this.previousElementSibling;var v=parseInt(inp.value);if(v>=1&&v<=@pgTotal)location.href='@(pgBaseUrl)'+v;" 
                            title="@(isAr ? "انتقال" : "Go")">
                        <i class="bi bi-arrow-return-left"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .smart-pagination {
        padding: 12px 0;
        display: flex;
        justify-content: center;
    }
    .smart-pagination-inner {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .sp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        color: var(--text-secondary, #adb5bd);
        text-decoration: none;
        transition: all 0.2s ease;
        font-size: 0.8rem;
    }
    .sp-btn:hover:not(.sp-disabled) {
        background: rgba(255,255,255,0.1);
        color: var(--accent-primary, #7c6aef);
        border-color: var(--accent-primary, #7c6aef);
    }
    .sp-disabled {
        opacity: 0.3;
        pointer-events: none;
        cursor: not-allowed;
    }
    .sp-pages {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .sp-page {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 34px;
        padding: 0 6px;
        border-radius: 8px;
        background: transparent;
        color: var(--text-secondary, #adb5bd);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }
    .sp-page:hover:not(.sp-active) {
        background: rgba(255,255,255,0.06);
        color: var(--text-primary, #e8eaed);
    }
    .sp-active {
        background: var(--accent-gradient, linear-gradient(135deg, #7c6aef, #a78bfa));
        color: #fff !important;
        font-weight: 600;
        border-color: transparent;
        box-shadow: 0 2px 8px rgba(124, 106, 239, 0.3);
    }
    .sp-ellipsis {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 34px;
        color: var(--text-muted, #6c757d);
        font-size: 1rem;
        letter-spacing: 2px;
        user-select: none;
    }
    .sp-info {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-inline-start: 12px;
        padding-inline-start: 12px;
        border-inline-start: 1px solid rgba(255,255,255,0.08);
    }
    .sp-info-text {
        font-size: 0.8rem;
        color: var(--text-muted, #6c757d);
        white-space: nowrap;
    }
    .sp-info-text strong {
        color: var(--text-secondary, #adb5bd);
    }
    .sp-jump {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .sp-jump-input {
        width: 60px;
        height: 30px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: var(--text-primary, #e8eaed);
        font-size: 0.8rem;
        text-align: center;
        outline: none;
        transition: border-color 0.2s;
        -moz-appearance: textfield;
    }
    .sp-jump-input::-webkit-inner-spin-button,
    .sp-jump-input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .sp-jump-input:focus {
        border-color: var(--accent-primary, #7c6aef);
    }
    .sp-jump-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: var(--text-secondary, #adb5bd);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.75rem;
    }
    .sp-jump-btn:hover {
        background: var(--accent-primary, #7c6aef);
        color: #fff;
        border-color: var(--accent-primary, #7c6aef);
    }

    @@media (max-width: 576px) {
        .sp-info { 
            margin-inline-start: 0; 
            padding-inline-start: 0; 
            border-inline-start: none;
            margin-top: 8px;
            width: 100%;
            justify-content: center;
        }
        .smart-pagination-inner {
            justify-content: center;
        }
    }
</style>
