@model List<IdentitySyncPro.Core.Models.Settings.SmsSendLog>
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "سجل إرسال الرسائل" : "SMS Send Log";
    string Mask(string? p) => string.IsNullOrEmpty(p) ? "" : IdentitySyncPro.Core.Helpers.PhoneHelper.MaskPhone(p);
    string Badge(string s) => s switch { "Success" => "bg-success", "Failed" => "bg-danger", _ => "bg-secondary" };
    int page = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int retryable = ViewBag.RetryableCount ?? 0;
    var curStatus = ViewBag.Status as string;
    string? Sel(string v) => curStatus == v ? "selected" : null;
    string SrcLabel(string s) => s switch
    {
        "Offboarding" => isAr ? "إخلاء طرف" : "Offboarding",
        "AccountStatus" => isAr ? "تفعيل/تعطيل" : "Account Status",
        _ => isAr ? "مزامنة" : "Sync"
    };
}
@Html.AntiForgeryToken()

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="fw-700 mb-1"><i class="bi bi-journal-text me-2 text-accent"></i>@(isAr ? "سجل إرسال الرسائل" : "SMS Send Log")</h5>
        <p class="text-muted fs-sm mb-0">@(isAr ? "من أُرسلت له بيانات الدخول ومن فشل — مع إعادة إرسال الفاشلة" : "Who received their credentials SMS and who didn't — with retry")</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-glass"><i class="bi bi-arrow-@(isAr ? "right" : "left") me-1"></i>@(isAr ? "المزودون" : "Providers")</a>
        <a href="@Url.Action("ExportLog", new { status = ViewBag.Status, account = ViewBag.Account, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo })" class="btn btn-glass"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <button id="btnRetryAll" class="btn btn-accent" @(retryable == 0 ? "disabled" : "")>
            <i class="bi bi-arrow-repeat me-1"></i>@(isAr ? $"إعادة إرسال الفاشلة ({retryable})" : $"Retry failed ({retryable})")
        </button>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="glass-card border-0 p-3"><div class="text-muted fs-sm">@(isAr ? "نجحت" : "Success")</div><div class="fw-700 fs-4 text-success">@ViewBag.SuccessCount</div></div></div>
    <div class="col-6 col-lg-3"><div class="glass-card border-0 p-3"><div class="text-muted fs-sm">@(isAr ? "فشلت" : "Failed")</div><div class="fw-700 fs-4 text-danger">@ViewBag.FailedCount</div></div></div>
    <div class="col-6 col-lg-3"><div class="glass-card border-0 p-3"><div class="text-muted fs-sm">@(isAr ? "تُخطّيت" : "Skipped")</div><div class="fw-700 fs-4 text-secondary">@ViewBag.SkippedCount</div></div></div>
    <div class="col-6 col-lg-3"><div class="glass-card border-0 p-3"><div class="text-muted fs-sm">@(isAr ? "قابلة للإعادة" : "Retryable")</div><div class="fw-700 fs-4 text-accent">@retryable</div></div></div>
</div>

<!-- Filters -->
<form method="get" class="glass-card border-0 p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="fs-sm text-muted">@(isAr ? "الحالة" : "Status")</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">@(isAr ? "الكل" : "All")</option>
                <option value="Success" selected="@Sel("Success")">Success</option>
                <option value="Failed" selected="@Sel("Failed")">Failed</option>
                <option value="Skipped" selected="@Sel("Skipped")">Skipped</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="fs-sm text-muted">@(isAr ? "الحساب / المستخدم" : "Account / Username")</label>
            <input type="text" name="account" value="@ViewBag.Account" class="form-control form-control-sm" placeholder="@(isAr ? "الحساب أو رقم الهوية" : "account or ID")" />
        </div>
        <div class="col-md-2">
            <label class="fs-sm text-muted">@(isAr ? "من" : "From")</label>
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="fs-sm text-muted">@(isAr ? "إلى" : "To")</label>
            <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-glass btn-sm"><i class="bi bi-funnel me-1"></i>@(isAr ? "تصفية" : "Filter")</button>
            <a href="@Url.Action("Log")" class="btn btn-glass btn-sm">@(isAr ? "مسح" : "Clear")</a>
        </div>
    </div>
</form>

<div class="glass-card border-0 p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="fs-sm text-muted">
                    <th>@(isAr ? "المصدر" : "Source")</th>
                    <th>@(isAr ? "الحساب" : "Account")</th>
                    <th>@(isAr ? "الجوال" : "Mobile")</th>
                    <th>@(isAr ? "الحالة" : "Status")</th>
                    <th>@(isAr ? "المزود" : "Provider")</th>
                    <th>@(isAr ? "الرد / الخطأ" : "Response / Error")</th>
                    <th>@(isAr ? "محاولات" : "Retries")</th>
                    <th>@(isAr ? "الوقت" : "Time")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">@(isAr ? "لا توجد سجلات" : "No records")</td></tr>
                }
                @foreach (var l in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark">@SrcLabel(l.Source)</span></td>
                        <td><span class="fw-600">@l.Account</span><div class="fs-sm text-muted">@l.DisplayName</div></td>
                        <td class="fs-sm">@Mask(l.PhoneNumber)</td>
                        <td><span class="badge @Badge(l.Status)">@l.Status</span></td>
                        <td class="fs-sm">@l.ProviderName</td>
                        <td class="fs-sm text-truncate" style="max-width:280px" title="@l.GatewayResponse">@l.GatewayResponse</td>
                        <td class="fs-sm">@l.RetryCount</td>
                        <td class="fs-sm text-muted">@l.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            @if (l.IsRetryable)
                            {
                                <button class="btn btn-sm btn-glass btn-retry-one" data-id="@l.Id" title="@(isAr ? "إعادة إرسال" : "Retry")"><i class="bi bi-arrow-repeat"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
        @for (int p = 1; p <= totalPages; p++)
        {
            <li class="page-item @(p == page ? "active" : "")">
                <a class="page-link" href="@Url.Action("Log", new { status = ViewBag.Status, account = ViewBag.Account, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, page = p })">@p</a>
            </li>
        }
    </ul></nav>
}

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const isAr = @(isAr ? "true" : "false");

    async function retry(ids) {
        const body = new URLSearchParams();
        (ids || []).forEach(id => body.append('ids', id));
        try {
            const res = await fetch('@Url.Action("RetryFailed")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            });
            const data = await res.json();
            alert(data.message || (isAr ? 'تم' : 'Done'));
            setTimeout(() => location.reload(), 1500);
        } catch (e) {
            alert(isAr ? 'فشل بدء إعادة الإرسال' : 'Failed to start retry');
        }
    }

    document.getElementById('btnRetryAll')?.addEventListener('click', () => {
        if (confirm(isAr ? 'إعادة إرسال كل الرسائل الفاشلة؟' : 'Retry all failed messages?')) retry(null);
    });
    document.querySelectorAll('.btn-retry-one').forEach(btn =>
        btn.addEventListener('click', () => retry([btn.dataset.id])));
</script>
}
