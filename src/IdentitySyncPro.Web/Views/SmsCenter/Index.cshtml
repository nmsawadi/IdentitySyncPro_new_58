@model List<IdentitySyncPro.Core.Models.Settings.SmsProvider>
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "مركز الإشعارات" : "Notifications Center";
}
@Html.AntiForgeryToken()

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="fw-700 mb-1">
            <i class="bi bi-chat-dots-fill me-2 text-accent"></i>
            @(isAr ? "مركز الإشعارات" : "Notifications Center")
        </h5>
        <p class="text-muted fs-sm mb-0">@(isAr ? "إدارة مزودي الإشعارات — اختر المزود المناسب من أي مكان في النظام" : "Manage notification providers — select the right provider from anywhere in the system")</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "EmailProvider")" class="btn btn-glass">
            <i class="bi bi-envelope-at me-1"></i>
            @(isAr ? "البريد" : "Email")
        </a>
        <a href="@Url.Action("Log")" class="btn btn-glass">
            <i class="bi bi-journal-text me-1"></i>
            @(isAr ? "سجل الإرسال" : "Send Log")
        </a>
        <a href="@Url.Action("Create")" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i>
            @(isAr ? "مزود جديد" : "New Provider")
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Count == 0)
{
    <!-- Empty State -->
    <div class="glass-card text-center py-5">
        <div style="font-size: 4rem; opacity: 0.3; margin-bottom: 1rem;">
            <i class="bi bi-chat-dots"></i>
        </div>
        <h5 class="text-muted fw-600">@(isAr ? "لا توجد مزودي رسائل بعد" : "No SMS providers yet")</h5>
        <p class="text-muted fs-sm mb-3">@(isAr ? "أضف أول مزود SMS لإرسال الإشعارات من النظام" : "Add your first SMS provider to send notifications from the system")</p>
        <a href="@Url.Action("Create")" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i>
            @(isAr ? "إضافة مزود" : "Add Provider")
        </a>
    </div>
}
else
{
    <!-- Providers Grid -->
    <div class="row g-4">
        @foreach (var provider in Model)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="glass-card h-100 svc-card @(!provider.IsActive ? "opacity-50" : "")">
                    <!-- Card Header -->
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="svc-icon" style="background:linear-gradient(135deg, #a855f7, #7c3aed)">
                                <i class="bi bi-chat-dots-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-700 mb-0">@provider.Name</h6>
                                <span class="fs-xs text-muted">@(provider.IsActive ? (isAr ? "نشط" : "Active") : (isAr ? "معطّل" : "Disabled"))</span>
                            </div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @(provider.IsActive ? "checked" : "")
                                   onchange="toggleProvider(@provider.Id)" title="@(isAr ? "تفعيل/تعطيل" : "Toggle")">
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(provider.Notes))
                    {
                        <p class="text-muted fs-sm mb-3">@provider.Notes</p>
                    }

                    <!-- Provider Details -->
                    <div class="svc-info-grid mb-3">
                        <div class="svc-info-item">
                            <i class="bi bi-link-45deg text-info"></i>
                            <div>
                                <span class="fs-xs text-muted">API URL</span>
                                <span class="fs-sm fw-600 d-block text-truncate" title="@provider.ApiUrl">@provider.ApiUrl</span>
                            </div>
                        </div>
                        <div class="svc-info-item">
                            <i class="bi bi-person-badge text-accent"></i>
                            <div>
                                <span class="fs-xs text-muted">@(isAr ? "اسم المرسل" : "Sender")</span>
                                <span class="fs-sm fw-600 d-block">@provider.SenderName</span>
                            </div>
                        </div>
                    </div>

                    <!-- Created Date -->
                    <div class="fs-xs text-muted mb-3">
                        <i class="bi bi-clock me-1"></i>
                        @(isAr ? "تاريخ الإضافة:" : "Created:") @provider.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success flex-fill"
                                onclick="openTestModal(@provider.Id, '@provider.Name')">
                            <i class="bi bi-send-fill me-1"></i> @(isAr ? "تجربة" : "Test")
                        </button>
                        <a href="@Url.Action("Edit", new { id = provider.Id })" class="btn btn-sm btn-outline-info flex-fill">
                            <i class="bi bi-pencil-fill me-1"></i> @(isAr ? "تعديل" : "Edit")
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline flex-fill"
                              onsubmit="return confirm('@(isAr ? "هل أنت متأكد من حذف هذا المزود؟" : "Are you sure you want to delete this provider?")')">
                            <input type="hidden" name="id" value="@provider.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                <i class="bi bi-trash-fill me-1"></i> @(isAr ? "حذف" : "Delete")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Test SMS Modal -->
<div class="modal fade" id="testSmsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-0">
                <h6 class="fw-700 mb-0" id="testModalTitle">
                    <i class="bi bi-send-fill me-2 text-success"></i>
                    @(isAr ? "تجربة إرسال رسالة" : "Test SMS")
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="testProviderId" />
                <div class="mb-3">
                    <label class="form-label">@(isAr ? "رقم الجوال" : "Phone Number") <span class="text-danger">*</span></label>
                    <input type="text" id="testPhone" class="form-control" dir="ltr"
                           placeholder="05xxxxxxxx" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@(isAr ? "نص الرسالة" : "Message") <span class="text-danger">*</span></label>
                    <textarea id="testMessage" class="form-control" rows="3"
                              placeholder="@(isAr ? "مرحباً، هذه رسالة تجريبية من نظام IdentitySyncPro" : "Hello, this is a test message from IdentitySyncPro")"></textarea>
                </div>
                <div id="testResult" class="d-none"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">
                    @(isAr ? "إلغاء" : "Cancel")
                </button>
                <button type="button" class="btn btn-success" id="btnSendTest" onclick="sendTestSms()">
                    <i class="bi bi-send-fill me-1"></i>
                    @(isAr ? "إرسال" : "Send")
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .svc-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .svc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    }
    .svc-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: white;
        flex-shrink: 0;
    }
    .svc-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }
    .svc-info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.6rem;
        border-radius: 8px;
        background: rgba(255,255,255,0.02);
    }
    .svc-info-item i {
        font-size: 1.1rem;
        flex-shrink: 0;
    }
</style>
<script>
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    async function toggleProvider(id) {
        try {
            const res = await fetch('@Url.Action("ToggleActive")?id=' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getAntiForgeryToken() }
            });
            const data = await res.json();
            if (!data.success) {
                location.reload();
            }
        } catch (e) {
            location.reload();
        }
    }

    function openTestModal(providerId, providerName) {
        document.getElementById('testProviderId').value = providerId;
        document.getElementById('testPhone').value = '';
        document.getElementById('testMessage').value = '';
        document.getElementById('testResult').className = 'd-none';
        document.getElementById('testResult').innerHTML = '';
        document.getElementById('btnSendTest').disabled = false;
        document.getElementById('btnSendTest').innerHTML = '<i class="bi bi-send-fill me-1"></i> @(isAr ? "إرسال" : "Send")';
        document.getElementById('testModalTitle').innerHTML =
            '<i class="bi bi-send-fill me-2 text-success"></i> @(isAr ? "تجربة إرسال رسالة عبر" : "Test SMS via"): ' + providerName;
        const modal = new bootstrap.Modal(document.getElementById('testSmsModal'));
        modal.show();
    }

    async function sendTestSms() {
        const providerId = document.getElementById('testProviderId').value;
        const phone = document.getElementById('testPhone').value.trim();
        const message = document.getElementById('testMessage').value.trim();
        const resultDiv = document.getElementById('testResult');
        const btn = document.getElementById('btnSendTest');

        if (!phone) { showToast('@(isAr ? "يرجى إدخال رقم الجوال" : "Please enter a phone number")', 'error'); return; }
        if (!message) { showToast('@(isAr ? "يرجى إدخال نص الرسالة" : "Please enter a message")', 'error'); return; }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> @(isAr ? "جاري الإرسال..." : "Sending...")';
        resultDiv.className = 'd-none';

        try {
            const formData = new URLSearchParams();
            formData.append('providerId', providerId);
            formData.append('phoneNumber', phone);
            formData.append('message', message);

            const res = await fetch('@Url.Action("SendTest")', {
                method: 'POST',
                headers: Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, { 'RequestVerificationToken': getAntiForgeryToken() }),
                body: formData
            });
            const data = await res.json();

            if (data.success) {
                resultDiv.className = 'alert alert-success py-2 fs-sm';
                resultDiv.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> @(isAr ? "تم الإرسال بنجاح!" : "Sent successfully!")';
            } else {
                resultDiv.className = 'alert alert-danger py-2 fs-sm';
                resultDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> ' + (data.error || '@(isAr ? "فشل الإرسال" : "Send failed")');
            }
        } catch (e) {
            resultDiv.className = 'alert alert-danger py-2 fs-sm';
            resultDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> ' + e.message;
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> @(isAr ? "إرسال" : "Send")';
    }
</script>
}
