@model IdentitySyncPro.Web.Models.SettingsViewModel
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "الإعدادات" : "Settings";
}

<!-- Header -->
<div class="glass-card mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h6 class="fw-600 mb-1"><i class="bi bi-sliders2 me-2 text-accent"></i>@(isAr ? "إعدادات الدومينات وقواعد البيانات" : "Domain & Database Settings")</h6>
            <p class="fs-sm text-muted mb-0">@(isAr ? "إدارة إعدادات الاتصال بالدومينات المتعددة وقواعد البيانات المختلفة" : "Manage connection settings for multiple domains and databases")</p>
        </div>
        <a href="@Url.Action("Create", "Settings")" class="btn btn-glow" id="btnAddTenant">
            <i class="bi bi-plus-lg me-1"></i> @(isAr ? "إضافة جهة جديدة" : "Add New Tenant")
        </a>
    </div>
</div>

<!-- Tenants List -->
@if (Model.Tenants.Any())
{
    <div class="row g-4 mb-4">
        @foreach (var tenant in Model.Tenants)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="glass-card tenant-card @(tenant.IsActive ? "active" : "")" id="tenant-@tenant.Id">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="tenant-status" style="background:@(tenant.IsActive ? "var(--success)" : "var(--text-muted)")"></div>
                            <div>
                                <h6 class="fw-600 mb-0">@tenant.TenantName</h6>
                                @if (!string.IsNullOrEmpty(tenant.Description))
                                {
                                    <span class="fs-xs text-muted">@tenant.Description</span>
                                }
                            </div>
                        </div>
                        <span class="badge-status @(tenant.IsActive ? "badge-success" : "badge-muted")">
                            @(tenant.IsActive ? (isAr ? "نشط" : "Active") : (isAr ? "معطّل" : "Disabled"))
                        </span>
                    </div>

                    <!-- Connection Summary -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2 fs-sm">
                            <i class="bi bi-diagram-3-fill" style="color:var(--accent-primary);width:18px"></i>
                            <span class="text-muted">@(isAr ? "الدومين:" : "Domain:")</span>
                            <span class="fw-600 text-accent">@(string.IsNullOrEmpty(tenant.ADServer) ? "—" : tenant.ADServer)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 fs-sm">
                            <i class="bi bi-database-fill" style="color:var(--warning);width:18px"></i>
                            <span class="text-muted">@(isAr ? "المصدر:" : "Source:")</span>
                            <span class="badge-status badge-warning">@tenant.SourceProvider</span>
                            <span class="fw-600" style="color:var(--warning)">@(string.IsNullOrEmpty(tenant.SourceHost) ? "—" : $"{tenant.SourceHost}:{tenant.SourcePort}")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 fs-sm">
                            <i class="bi bi-server" style="color:var(--info);width:18px"></i>
                            <span class="text-muted">@(isAr ? "قاعدة البيانات:" : "DB:")</span>
                            <span class="badge-status badge-info">@tenant.DatabaseProvider</span>
                            <span class="fs-xs">@(string.IsNullOrEmpty(tenant.DbHost) ? "" : tenant.DbHost)</span>
                        </div>
                        @* "Auto / Manual" said nothing about WHICH schedule was live. A tenant can
                           have the full pass running and the delta suspended, and the old label read
                           identically either way — the same ambiguity that let a schedule sit idle
                           for a day unnoticed. Each type now shows its own state and toggles on click. *@
                        @{
                            var fullLive  = tenant.IsActive && tenant.EnableAutoSync && tenant.EnableFullSyncSchedule
                                            && !string.IsNullOrWhiteSpace(tenant.FullSyncSchedule);
                            var deltaLive = tenant.IsActive && tenant.EnableAutoSync && tenant.EnableDeltaSyncSchedule
                                            && !string.IsNullOrWhiteSpace(tenant.DeltaSyncSchedule);
                        }
                        <div class="d-flex align-items-center gap-2 fs-sm">
                            <i class="bi bi-clock-history" style="color:var(--success);width:18px"></i>
                            <span class="text-muted">@(isAr ? "الجدولة:" : "Scheduling:")</span>
                            <button type="button" class="btn btn-glass btn-sm py-0 px-2 sync-master-toggle"
                                    data-id="@tenant.Id"
                                    title="@(isAr ? "المفتاح الرئيسي — يوقف النوعين معاً" : "Master switch — suspends both types")">
                                <span class="badge-status @(tenant.EnableAutoSync ? "badge-success" : "badge-muted")" data-master="@tenant.Id">
                                    @(tenant.EnableAutoSync ? (isAr ? "تلقائية" : "Auto") : (isAr ? "يدوية" : "Manual"))
                                </span>
                            </button>
                        </div>

                        <div class="d-flex align-items-center gap-2 fs-sm ms-4">
                            <span class="text-muted" style="width:74px">@(isAr ? "الكاملة" : "Full")</span>
                            <button type="button" class="btn btn-glass btn-sm py-0 px-2 sync-type-toggle"
                                    data-id="@tenant.Id" data-type="full"
                                    title="@IdentitySyncPro.Infrastructure.Services.CronBuilder.Describe(tenant.FullSyncSchedule, isAr)">
                                <span class="badge-status @(fullLive ? "badge-success" : "badge-muted")" data-state="full-@tenant.Id">
                                    @(fullLive ? (isAr ? "تعمل" : "Running") : (isAr ? "موقوفة" : "Suspended"))
                                </span>
                            </button>
                            <span class="fs-xs text-muted">@IdentitySyncPro.Infrastructure.Services.CronBuilder.Describe(tenant.FullSyncSchedule, isAr)</span>
                        </div>

                        <div class="d-flex align-items-center gap-2 fs-sm ms-4">
                            <span class="text-muted" style="width:74px">@(isAr ? "التغييرات" : "Delta")</span>
                            <button type="button" class="btn btn-glass btn-sm py-0 px-2 sync-type-toggle"
                                    data-id="@tenant.Id" data-type="delta"
                                    title="@IdentitySyncPro.Infrastructure.Services.CronBuilder.Describe(tenant.DeltaSyncSchedule, isAr)">
                                <span class="badge-status @(deltaLive ? "badge-success" : "badge-muted")" data-state="delta-@tenant.Id">
                                    @(deltaLive ? (isAr ? "تعمل" : "Running") : (isAr ? "موقوفة" : "Suspended"))
                                </span>
                            </button>
                            <span class="fs-xs text-muted">@IdentitySyncPro.Infrastructure.Services.CronBuilder.Describe(tenant.DeltaSyncSchedule, isAr)</span>
                        </div>
                    </div>

                    <div class="fs-xs text-muted mb-3">
                        <i class="bi bi-clock me-1"></i>
                        @(isAr ? "آخر تعديل:" : "Modified:") @tenant.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", "Settings", new { id = tenant.Id })" class="btn btn-glass btn-sm flex-grow-1">
                            <i class="bi bi-pencil me-1"></i> @(isAr ? "تعديل" : "Edit")
                        </a>
                        <a href="@Url.Action("Mapping", "Settings", new { id = tenant.Id })" class="btn btn-success-glass btn-sm flex-grow-1">
                            <i class="bi bi-arrow-left-right me-1"></i> @(isAr ? "الربط" : "Mapping")
                        </a>
                        <button class="btn btn-glass btn-sm" onclick="toggleTenant(@tenant.Id)" title="@(isAr ? "تفعيل/تعطيل" : "Toggle")">
                            <i class="bi bi-power"></i>
                        </button>
                        <button class="btn btn-danger-glass btn-sm" onclick="deleteTenant(@tenant.Id)" title="@(isAr ? "حذف" : "Delete")">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="glass-card">
        <div class="empty-state">
            <i class="bi bi-building-gear"></i>
            <h6>@(isAr ? "لا توجد جهات مُعدّة بعد" : "No tenants configured yet")</h6>
            <p class="text-muted">@(isAr ? "أضف جهة جديدة لبدء إعداد الدومين وقاعدة البيانات" : "Add a new tenant to start configuring domains and databases")</p>
            <a href="@Url.Action("Create", "Settings")" class="btn btn-glow mt-2">
                <i class="bi bi-plus-lg me-1"></i> @(isAr ? "إضافة أول جهة" : "Add First Tenant")
            </a>
        </div>
    </div>
}
<!-- Data Retention Settings -->
<div class="glass-card mb-4" id="retentionCard">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div>
            <h6 class="fw-600 mb-1"><i class="bi bi-clock-history me-2" style="color:var(--warning)"></i>@(isAr ? "إعدادات الاحتفاظ بالبيانات" : "Data Retention Settings")</h6>
            <p class="fs-sm text-muted mb-0">@(isAr ? "تحديد فترات حفظ السجلات التشغيلية — التنظيف يتم تلقائياً كل يوم أحد" : "Configure how long operational records are kept — cleanup runs every Sunday at 3 AM")</p>
        </div>
        <span class="badge-status badge-success"><i class="bi bi-shield-check me-1"></i>@(isAr ? "لا يمس حسابات AD" : "AD accounts safe")</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4 col-sm-6">
            <label class="form-label fs-sm fw-600">
                <i class="bi bi-arrow-repeat me-1 text-accent"></i>@(isAr ? "عمليات المزامنة" : "Sync Operations")
            </label>
            <div class="input-group">
                <input type="number" class="form-control" id="retSyncOps" min="7" max="730" value="90">
                <span class="input-group-text fs-sm">@(isAr ? "يوم" : "days")</span>
            </div>
            <div class="fs-xs text-muted mt-1">@(isAr ? "افتراضي: 90 يوم (3 أشهر)" : "Default: 90 days (3 months)")</div>
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label fs-sm fw-600">
                <i class="bi bi-journal-text me-1" style="color:var(--info)"></i>@(isAr ? "سجلات التشغيل" : "Sync Runs")
            </label>
            <div class="input-group">
                <input type="number" class="form-control" id="retSyncRuns" min="7" max="730" value="180">
                <span class="input-group-text fs-sm">@(isAr ? "يوم" : "days")</span>
            </div>
            <div class="fs-xs text-muted mt-1">@(isAr ? "افتراضي: 180 يوم (6 أشهر)" : "Default: 180 days (6 months)")</div>
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label fs-sm fw-600">
                <i class="bi bi-shield-lock me-1" style="color:var(--success)"></i>@(isAr ? "سجلات التدقيق" : "Audit Entries")
            </label>
            <div class="input-group">
                <input type="number" class="form-control" id="retAudit" min="30" max="1825" value="365">
                <span class="input-group-text fs-sm">@(isAr ? "يوم" : "days")</span>
            </div>
            <div class="fs-xs text-muted mt-1">@(isAr ? "افتراضي: 365 يوم (سنة)" : "Default: 365 days (1 year)")</div>
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label fs-sm fw-600">
                <i class="bi bi-exclamation-triangle me-1" style="color:var(--danger)"></i>@(isAr ? "العمليات الفاشلة (DLQ)" : "Dead Letter Queue")
            </label>
            <div class="input-group">
                <input type="number" class="form-control" id="retDLQ" min="7" max="365" value="30">
                <span class="input-group-text fs-sm">@(isAr ? "يوم" : "days")</span>
            </div>
            <div class="fs-xs text-muted mt-1">@(isAr ? "افتراضي: 30 يوم (المُعاد تشغيلها فقط)" : "Default: 30 days (replayed only)")</div>
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label fs-sm fw-600">
                <i class="bi bi-ban me-1" style="color:var(--warning)"></i>@(isAr ? "الهويات المحجورة" : "Quarantine")
            </label>
            <div class="input-group">
                <input type="number" class="form-control" id="retQuar" min="7" max="365" value="60">
                <span class="input-group-text fs-sm">@(isAr ? "يوم" : "days")</span>
            </div>
            <div class="fs-xs text-muted mt-1">@(isAr ? "افتراضي: 60 يوم (المحلولة فقط)" : "Default: 60 days (resolved only)")</div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-glow btn-sm" onclick="saveRetention()" id="btnSaveRetention">
            <i class="bi bi-check-lg me-1"></i>@(isAr ? "حفظ الإعدادات" : "Save Settings")
        </button>
        <span id="retentionStatus" class="fs-sm align-self-center"></span>
    </div>
</div>

@section Scripts {
<script>
    // Load retention settings on page load
    document.addEventListener('DOMContentLoaded', loadRetention);

    async function loadRetention() {
        try {
            const res = await fetch('/Settings/GetRetentionSettings');
            const data = await res.json();
            document.getElementById('retSyncOps').value = data.syncOperationsDays;
            document.getElementById('retSyncRuns').value = data.syncRunsDays;
            document.getElementById('retAudit').value = data.auditEntriesDays;
            document.getElementById('retDLQ').value = data.deadLetterDays;
            document.getElementById('retQuar').value = data.quarantineDays;
        } catch (e) {
            console.warn('Could not load retention settings', e);
        }
    }

    async function saveRetention() {
        const btn = document.getElementById('btnSaveRetention');
        const status = document.getElementById('retentionStatus');
        btn.disabled = true;

        try {
            const body = {
                syncOperationsDays: parseInt(document.getElementById('retSyncOps').value) || 90,
                syncRunsDays: parseInt(document.getElementById('retSyncRuns').value) || 180,
                auditEntriesDays: parseInt(document.getElementById('retAudit').value) || 365,
                deadLetterDays: parseInt(document.getElementById('retDLQ').value) || 30,
                quarantineDays: parseInt(document.getElementById('retQuar').value) || 60
            };

            const res = await fetch('/Settings/SaveRetentionSettings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();

            if (data.success) {
                status.innerHTML = '<span style="color:var(--success)"><i class="bi bi-check-circle me-1"></i>' +
                    (currentLang === 'ar' ? 'تم الحفظ' : 'Saved') + '</span>';
                showToast(currentLang === 'ar' ? 'تم حفظ إعدادات الاحتفاظ' : 'Retention settings saved', 'success');
            } else {
                status.innerHTML = '<span style="color:var(--danger)">' + data.message + '</span>';
            }
        } catch (e) {
            status.innerHTML = '<span style="color:var(--danger)">Error</span>';
        }

        btn.disabled = false;
        setTimeout(() => { status.innerHTML = ''; }, 3000);
    }

    async function deleteTenant(id) {
        const msg = currentLang === 'ar' ? 'هل أنت متأكد من حذف هذه الجهة؟' : 'Are you sure you want to delete this tenant?';
        if (!confirm(msg)) return;

        try {
            const res = await fetch('/Settings/Delete?id=' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast(currentLang === 'ar' ? 'تم الحذف بنجاح' : 'Deleted successfully', 'success');
                document.getElementById('tenant-' + id)?.closest('.col-lg-6')?.remove();
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast('Request failed', 'error');
        }
    }

    async function toggleTenant(id) {
        try {
            const res = await fetch('/Settings/ToggleActive?id=' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                location.reload();
            }
        } catch (e) {
            showToast('Request failed', 'error');
        }
    }

    // ── Suspend / resume a tenant's schedules ───────────────────────────────
    // The layout attaches the antiforgery token to every non-GET fetch, so none is added here.
    //
    // Each badge is repainted from what the SERVER reports is now live, never from what was
    // clicked. A per-type switch can be on while the master is off, and showing "Running" in that
    // case would be the same lie that let a schedule sit idle unnoticed for a day.
    // Wrapped in an IIFE: a top-level `const` here shares one scope with _Layout and every other
    // view script, and redeclaring a name that already exists there kills this whole block
    // silently — the Razor build reports nothing about the contents of a <script> tag.
    (function () {
    // Serialized, not interpolated. Razor HTML-encodes @@(...) output, and the HTML parser does NOT
    // decode entities inside a <script> block — so '@@(isAr ? "موقوفة" : ...)' reaches JavaScript as
    // the literal text "&#x645;&#x648;…", which is exactly what a badge then displayed.
    // JsonSerializer emits \uXXXX escapes that JavaScript decodes correctly, and quotes the string
    // safely. This is the pattern the dashboard and reports views already use.
    const L = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        running   = isAr ? "تعمل" : "Running",
        suspended = isAr ? "موقوفة" : "Suspended",
        auto      = isAr ? "تلقائية" : "Auto",
        manual    = isAr ? "يدوية" : "Manual",
        failed    = isAr ? "تعذّر تغيير الجدولة — لم يتغيّر شيء" : "Could not change the schedule — nothing was changed"
    }));

    function paint(el, on, onText, offText) {
        if (!el) return;
        el.className = 'badge-status ' + (on ? 'badge-success' : 'badge-muted');
        el.textContent = on ? onText : offText;
    }

    document.querySelectorAll('.sync-type-toggle').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            const id = this.dataset.id, type = this.dataset.type;
            this.disabled = true;
            try {
                const body = new FormData();
                body.append('id', id);
                body.append('type', type);
                const res = await fetch('/Settings/ToggleSyncType', { method: 'POST', body: body });
                const data = await res.json();
                if (!data.success) { throw new Error(data.message || 'rejected'); }

                paint(document.querySelector('[data-state="' + type + '-' + id + '"]'),
                      data.scheduled, L.running, L.suspended);
            } catch (e) {
                showToast(L.failed, 'error');
            } finally {
                this.disabled = false;
            }
        });
    });

    document.querySelectorAll('.sync-master-toggle').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            const id = this.dataset.id;
            this.disabled = true;
            try {
                const body = new FormData();
                body.append('id', id);
                const res = await fetch('/Settings/ToggleAutoSync', { method: 'POST', body: body });
                const data = await res.json();
                if (!data.success) { throw new Error('rejected'); }

                paint(document.querySelector('[data-master="' + id + '"]'),
                      data.enableAutoSync, L.auto, L.manual);

                // The master governs both types, so their badges are no longer trustworthy.
                // Reloading is the honest option: the server decides every state, not this page.
                location.reload();
            } catch (e) {
                showToast(L.failed, 'error');
                this.disabled = false;
            }
        });
    });
    })();
</script>
}
