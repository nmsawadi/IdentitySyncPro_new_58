                <span class="fs-xs text-muted">@(isAr ? "إذا كان حقل معين فارغ، استخدم هذه القيمة بدلاً من إيقاف المزامنة" : "If a required field is empty, use this value instead of failing the sync")</span>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <div class="settings-form-group">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="UseGlobalDefaultForEmptyFields" value="true" @(Model.UseGlobalDefaultForEmptyFields ? "checked" : "") id="chkGlobalDefault" />
                        <label class="form-check-label fs-sm" for="chkGlobalDefault">@(isAr ? "تفعيل القيمة الافتراضية العالمية" : "Enable Global Default Value")</label>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="settings-form-group">
                    <label>@(isAr ? "قيمة فارغة:" : "Empty Field Value:")</label>
                    <input type="text" name="GlobalDefaultValue" value="@Model.GlobalDefaultValue" class="form-control" placeholder="., -, N/A, UNKNOWN" dir="ltr" />
                    <span class="fs-xs text-muted mt-1 d-block">@(isAr ? "مثل: . أو - أو N/A — تُستخدم لأي حقل فارغ" : "e.g.: . or - or N/A — used for any empty field")</span>
