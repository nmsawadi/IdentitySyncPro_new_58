        </div>

        <!-- Full Sync -->
        <div class="schedule-block mt-4">
            <h6 class="fw-600 fs-sm mb-2"><i class="bi bi-arrow-repeat me-1 text-success"></i> @(isAr ? "المزامنة الكاملة" : "Full Sync")</h6>
            @await Html.PartialAsync("_ScheduleEditor", new ViewDataDictionary(ViewData) {
                { "Prefix", "FullSync" }, { "Mode", Model.FullSyncMode }, { "Time", Model.FullSyncTime ?? "02:00" },
