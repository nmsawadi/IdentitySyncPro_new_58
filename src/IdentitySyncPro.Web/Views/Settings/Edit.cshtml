            @await Html.PartialAsync("_ScheduleEditor", new ViewDataDictionary(ViewData) {
                { "Prefix", "DeltaSync" }, { "Mode", Model.DeltaSyncMode }, { "Time", Model.DeltaSyncTime ?? "" },
                { "Days", Model.DeltaSyncDays ?? "" }, { "Interval", Model.DeltaSyncIntervalMinutes ?? 30 },
                { "Cron", Model.DeltaSyncSchedule }, { "IsAr", isAr }
