</form>

@section Scripts {
<script>
    // Show only the target that is actually selected. The AD block stays in the DOM and keeps
    // posting its values, so switching to SCIM and back does not erase a domain connection
    // somebody spent an afternoon getting right.
    //
    // Lives in the view's ONE Scripts section: a second @@section with the same name compiles
    // cleanly and throws "Section 'Scripts' is already defined" the moment the page is rendered.
    function onTargetChange() {
        var select = document.getElementById('targetProvider');
        if (!select) return;

        var isScim = select.value === 'Scim';
        var scim = document.getElementById('scimFields');
        var caveat = document.getElementById('scimCaveat');
        var ad = document.getElementById('adSection');

        if (scim) scim.style.display = isScim ? '' : 'none';
        if (caveat) caveat.style.display = isScim ? '' : 'none';
        if (ad) ad.style.display = isScim ? 'none' : '';
    }
    document.addEventListener('DOMContentLoaded', onTargetChange);
</script>
<script src="~/js/ldap-mode-hint.js"></script>
<script>
    // Live explanation of the chosen AD channel mode + port.
    document.addEventListener('DOMContentLoaded', function () {
        bindLdapModeHint({ mode: 'adSecurityMode', port: 'adPort', hint: 'adModeHint', rtl: @(isAr ? "true" : "false") });
    });
    // Creation policy: show the condition row only when it applies, and state the consequence
    // of the chosen mode in words — "Never" is the one setting that silently changes how many
    // accounts a run produces.
    function toggleCreationCondition() {
        const mode = document.getElementById('accountCreationMode').value;
        const isAr = currentLang === 'ar';
        document.querySelectorAll('.creation-condition').forEach(
            el => el.classList.toggle('d-none', mode !== 'Conditional'));

        const hint = document.getElementById('creationModeHint');
        if (!hint) return;

        if (mode === 'Never') {
            hint.className = 'alert alert-warning py-2 px-3 mb-0 fs-xs';
            hint.innerHTML = isAr
                ? '<i class="bi bi-exclamation-triangle me-1"></i> لن يُنشأ أي حساب. الهويات بلا حساب تُسجَّل «تخطٍّ» مع السبب، ويظهر مجموعها في نهاية كل تشغيلة. الحسابات القائمة تُحدَّث وتُنقل كالمعتاد.'
                : '<i class="bi bi-exclamation-triangle me-1"></i> No account will be created. Identities without one are logged as Skipped with the reason, and the run reports the total. Existing accounts are still updated and moved.';
        } else if (mode === 'Conditional') {
            hint.className = 'alert alert-info py-2 px-3 mb-0 fs-xs';
            hint.innerHTML = isAr
                ? '<i class="bi bi-funnel me-1"></i> يُنشأ الحساب فقط للهويات التي يتحقّق فيها الشرط أدناه — مثل «الموظفون النشطون فقط».'
                : '<i class="bi bi-funnel me-1"></i> An account is created only for identities matching the condition below — e.g. "active employees only".';
        } else {
            hint.className = 'alert alert-secondary py-2 px-3 mb-0 fs-xs';
            hint.innerHTML = isAr
                ? '<i class="bi bi-info-circle me-1"></i> كل هوية في المصدر بلا حساب في AD سيُنشأ لها حساب. هذا سلوك النظام الأصلي.'
                : '<i class="bi bi-info-circle me-1"></i> Every source identity without an AD account gets one. This is the original behaviour.';
        }
    }
    document.addEventListener('DOMContentLoaded', toggleCreationCondition);

    // Copies a username pattern so it can be pasted into the identifier rule's Transform
    // field on the Attribute Mapping screen (the pattern is not stored on this screen).
    function copyUsernamePattern(btn) {
        const pattern = btn.dataset.pattern;
        const done = () => {
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check2"></i> ' + (currentLang === 'ar' ? 'نُسخ' : 'Copied');
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');
            setTimeout(() => {
                btn.innerHTML = original;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1500);
        };

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(pattern).then(done).catch(() => window.prompt(
                currentLang === 'ar' ? 'انسخ القالب:' : 'Copy the pattern:', pattern));
        } else {
            // Plain HTTP is a supported deployment here, where the clipboard API is unavailable.
            window.prompt(currentLang === 'ar' ? 'انسخ القالب:' : 'Copy the pattern:', pattern);
        }
    }

    // Source provider selector
    function selectSrcProvider(btn) {
        document.querySelectorAll('#srcProviderSelector .db-provider-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('srcProvider').value = btn.dataset.provider;
        document.getElementById('srcPort').value = btn.dataset.port;
        const lbl = document.getElementById('srcDbLabel');
        if (lbl) lbl.textContent = btn.dataset.provider === 'Oracle'
            ? (currentLang==='ar' ? 'اسم الخدمة (Service Name) *' : 'Service Name *')
            : (currentLang==='ar' ? 'اسم قاعدة البيانات *' : 'Database Name *');
    }

    // selectProvider / toggleDbAuth / updateConnStrPreview were removed with the Application
    // Database section (2026-07-25) — they drove only its inputs.

    // Schedule mode selector
    function selectScheduleMode(prefix, mode) {
        document.querySelectorAll(`[data-schedule-prefix="${prefix}"] .sched-mode-btn`).forEach(b => b.classList.remove('active'));
        document.querySelector(`[data-schedule-prefix="${prefix}"] .sched-mode-btn[data-mode="${mode}"]`).classList.add('active');
        document.getElementById(prefix + 'Mode').value = mode;
        document.getElementById(prefix + '_interval_panel').style.display = mode === 'interval' ? '' : 'none';
        document.getElementById(prefix + '_daily_panel').style.display = mode === 'daily' ? '' : 'none';
        document.getElementById(prefix + '_weekly_panel').style.display = mode === 'weekly' ? '' : 'none';
        updateCronPreview(prefix);
    }

    function updateCronPreview(prefix) {
        const mode = document.getElementById(prefix + 'Mode').value;
        let cron = '', desc = '';
        if (mode === 'interval') {
            const mins = parseInt(document.getElementById(prefix + 'IntervalMinutes')?.value || '30');
            if (mins >= 60 && mins % 60 === 0) { cron = `0 */${mins/60} * * *`; desc = currentLang==='ar' ? `كل ${mins/60} ساعة` : `Every ${mins/60} hours`; }
            else { cron = `*/${mins} * * * *`; desc = currentLang==='ar' ? `كل ${mins} دقيقة` : `Every ${mins} minutes`; }
        } else if (mode === 'daily') {
            const t = document.getElementById(prefix + 'Time')?.value || '02:00';
            const [h,m] = t.split(':'); cron = `${parseInt(m)} ${parseInt(h)} * * *`; desc = currentLang==='ar' ? `يومياً ${t}` : `Daily at ${t}`;
        } else if (mode === 'weekly') {
            const t = document.getElementById(prefix + 'Time')?.value || '02:00';
            const [h,m] = t.split(':');
            const days = []; document.querySelectorAll(`#${prefix}_weekly_panel .day-btn.active`).forEach(b => days.push(b.dataset.day));
            const d = days.join(',') || '0,1,2,3,4,5,6'; cron = `${parseInt(m)} ${parseInt(h)} * * ${d}`;
            document.getElementById(prefix + 'Days').value = d; desc = currentLang==='ar' ? `أسبوعياً ${t}` : `Weekly at ${t}`;
        }
        document.getElementById(prefix + 'Schedule').value = cron;
        const el = document.getElementById(prefix + '_cron_desc'); if (el) el.textContent = desc;
    }

    function toggleDay(btn, prefix) { btn.classList.toggle('active'); updateCronPreview(prefix); }

    // Load SMS providers
    async function loadSmsProviders() {
        try {
            const res = await fetch('/SmsCenter/GetProviders');
            const data = await res.json();
            const sel = document.getElementById('smsProviderSelect');
            if (!sel) return;
            const currentId = '@(Model.SmsProviderId?.ToString() ?? "")';
            data.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id; opt.textContent = p.name + (p.senderName ? ' (' + p.senderName + ')' : '');
                if (p.id.toString() === currentId) opt.selected = true;
                sel.appendChild(opt);
            });
        } catch (e) { /* ignore */ }
    }

    // Init on load
    document.addEventListener('DOMContentLoaded', () => {
        ['FullSync','DeltaSync','HealthCheck'].forEach(p => { const m = document.getElementById(p+'Mode'); if(m) selectScheduleMode(p, m.value); });
        loadSmsProviders();
    });

    // Save
    async function saveTenant(e) {
        e.preventDefault();
        const form = document.getElementById('tenantForm');
        const btn = document.getElementById('btnSave');
        const formData = new FormData(form);
        if (!formData.has('IsActive')) formData.append('IsActive', 'false');
        if (!formData.has('ADAllowUntrustedCertificate')) formData.append('ADAllowUntrustedCertificate', 'false');
        if (!formData.has('EnableAutoSync')) formData.append('EnableAutoSync', 'false');
        if (!formData.has('EnableLifecycleDuringSync')) formData.append('EnableLifecycleDuringSync', 'false');
        if (!formData.has('EnableSmsNotification')) formData.append('EnableSmsNotification', 'false');
        if (!formData.has('UseGlobalDefaultForEmptyFields')) formData.append('UseGlobalDefaultForEmptyFields', 'false');
        if (!formData.has('DbIntegratedSecurity')) formData.append('DbIntegratedSecurity', 'false');
        if (!formData.has('DbTrustServerCertificate')) formData.append('DbTrustServerCertificate', 'false');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> ' + (currentLang==='ar' ? 'جاري الحفظ...' : 'Saving...');
        try {
            const res = await fetch('/Settings/Save', { method: 'POST', body: new URLSearchParams(formData) });
            const data = await res.json();
            if (data.success) { showToast(currentLang==='ar' ? 'تم حفظ الإعدادات بنجاح' : 'Settings saved', 'success'); setTimeout(() => window.location.href = '/Settings', 1500); }
            else { showToast(data.message, 'error'); }
        } catch (e) { showToast(currentLang==='ar' ? 'فشل الحفظ' : 'Save failed', 'error'); }
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> ' + (currentLang==='ar' ? 'حفظ الإعدادات' : 'Save Settings');
        return false;
    }
</script>
}

