    <!-- Actions -->
    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-glow" id="btnSave"><i class="bi bi-check-lg me-1"></i> @(isAr ? "حفظ الإعدادات" : "Save Settings")</button>
        <a href="@Url.Action("Index", "Settings")" class="btn btn-glass"><i class="bi bi-x-lg me-1"></i> @(isAr ? "إلغاء" : "Cancel")</a>
