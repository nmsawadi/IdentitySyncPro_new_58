@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "تغيير كلمة المرور" : "Change Password";
    var error = ViewBag.Error as string;
    var mustChange = User.HasClaim("pwd_change", "1");
}

<div class="d-flex justify-content-center">
    <div class="glass-card" style="max-width:480px;width:100%">
        <h6 class="fw-600 mb-1"><i class="bi bi-key-fill me-2 text-accent"></i>@(isAr ? "تغيير كلمة المرور" : "Change Password")</h6>

        @if (mustChange)
        {
            <div class="alert alert-warning py-2 fs-sm mt-2">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                @(isAr ? "يجب تغيير كلمة المرور قبل متابعة استخدام النظام" : "You must change your password before continuing")
            </div>
        }

        @if (error != null)
        {
            var msg = error switch
            {
                "mismatch" => isAr ? "كلمتا المرور غير متطابقتين" : "Passwords do not match",
                "wrong_current" => isAr ? "كلمة المرور الحالية غير صحيحة" : "Current password is incorrect",
                "policy_length" => isAr ? "كلمة المرور: 10 أحرف على الأقل" : "Password must be at least 10 characters",
                "policy_complexity" => isAr ? "كلمة المرور يجب أن تحوي حروفاً وأرقاماً" : "Password must contain letters and digits",
                "ad_user" => isAr ? "حسابك مرتبط بالدومين — غيّر كلمة المرور من الدومين" : "AD account — change your password in the domain",
                "same_as_current" => isAr ? "كلمة المرور الجديدة مطابقة للحالية — اختر كلمة مختلفة" : "The new password is the same as the current one — choose a different one",
                _ => isAr ? "تعذر تغيير كلمة المرور" : "Could not change password"
            };
            <div class="alert alert-danger py-2 fs-sm mt-2"><i class="bi bi-x-circle me-1"></i> @msg</div>
        }

        <form method="post" action="@Url.Action("ChangePassword", "Account")" class="mt-3">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fs-sm text-muted">@(isAr ? "كلمة المرور الحالية" : "Current Password")</label>
                <input type="password" name="currentPassword" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label class="form-label fs-sm text-muted">@(isAr ? "كلمة المرور الجديدة (10 أحرف فأكثر، حروف وأرقام)" : "New Password (10+ chars, letters & digits)")</label>
                <input type="password" name="newPassword" class="form-control" autocomplete="new-password" required minlength="10" />
            </div>
            <div class="mb-4">
                <label class="form-label fs-sm text-muted">@(isAr ? "تأكيد كلمة المرور الجديدة" : "Confirm New Password")</label>
                <input type="password" name="confirmPassword" class="form-control" autocomplete="new-password" required minlength="10" />
            </div>
            <button type="submit" class="btn btn-glow w-100">
                <i class="bi bi-check-lg me-1"></i> @(isAr ? "حفظ" : "Save")
            </button>
        </form>
    </div>
</div>
