@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "غير مصرح" : "Access Denied";
}

<div class="d-flex justify-content-center">
    <div class="glass-card text-center" style="max-width:440px;width:100%">
        <i class="bi bi-shield-x" style="font-size:3rem;color:var(--danger)"></i>
        <h5 class="fw-600 mt-3">@(isAr ? "لا تملك صلاحية الوصول" : "Access Denied")</h5>
        <p class="text-muted fs-sm">@(isAr ? "هذه الصفحة تتطلب صلاحية أعلى من دورك الحالي. تواصل مع مدير النظام." : "This page requires a higher role. Contact your system administrator.")</p>
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-glass mt-2">
            <i class="bi bi-arrow-right me-1"></i> @(isAr ? "العودة للوحة الرئيسية" : "Back to Dashboard")
        </a>
    </div>
</div>
