@model List<IdentitySyncPro.Core.Models.Services.SvcService>
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "إدارة الخدمات" : "Services Management";
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="fw-700 mb-1">
            <i class="bi bi-box-seam-fill me-2 text-accent"></i>
            @(isAr ? "إدارة الخدمات" : "Services Management")
        </h5>
        <p class="text-muted fs-sm mb-0">@(isAr ? "إنشاء وإدارة خدمات مزامنة قواعد البيانات مع Active Directory" : "Create and manage database-to-AD sync services")</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-accent" id="btnCreateService">
        <i class="bi bi-plus-lg me-1"></i>
        @(isAr ? "خدمة جديدة" : "New Service")
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Count == 0)
{
    <!-- Empty State -->
    <div class="glass-card text-center py-5">
        <div style="font-size: 4rem; opacity: 0.3; margin-bottom: 1rem;">
            <i class="bi bi-box-seam"></i>
        </div>
        <h5 class="text-muted fw-600">@(isAr ? "لا توجد خدمات بعد" : "No services yet")</h5>
        <p class="text-muted fs-sm mb-3">@(isAr ? "أنشئ أول خدمة لمزامنة بيانات قاعدة البيانات مع Active Directory" : "Create your first database-to-AD sync service")</p>
        <a href="@Url.Action("Create")" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i>
            @(isAr ? "إنشاء خدمة" : "Create Service")
        </a>
    </div>
}
else
{
    <!-- Services Grid -->
    <div class="row g-4">
        @foreach (var svc in Model)
        {
            var statusColor = svc.LastRunStatus switch
            {
                "Completed" => "success",
                "CompletedWithErrors" => "warning",
                "Failed" => "danger",
                "Running" => "info",
                _ => "secondary"
            };
            var statusIcon = svc.LastRunStatus switch
            {
                "Completed" => "check-circle-fill",
                "CompletedWithErrors" => "exclamation-triangle-fill",
                "Failed" => "x-circle-fill",
                "Running" => "arrow-repeat",
                _ => "circle"
            };
            var statusText = svc.LastRunStatus switch
            {
                "Completed" => isAr ? "مكتمل" : "Completed",
                "CompletedWithErrors" => isAr ? "مكتمل مع أخطاء" : "Completed with Errors",
                "Failed" => isAr ? "فشل" : "Failed",
                "Running" => isAr ? "قيد التشغيل" : "Running",
                _ => isAr ? "لم يشغّل بعد" : "Never Run"
            };

            <div class="col-lg-6 col-xl-4">
                <div class="glass-card h-100 svc-card">
                    <!-- Card Header -->
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="svc-icon @(svc.IsEnabled ? "" : "disabled") @(svc.ServiceType == "Offboarding" ? "offboarding" : "")">
                                <i class="bi bi-@(svc.ServiceType == "Offboarding" ? "person-x-fill" : svc.ServiceType == "EmptyAttrDisable" ? "person-fill-slash" : svc.ServiceType == "InactiveDisable" ? "clock-history" : svc.ServiceType == "AdAudit" ? "shield-check" : svc.ServiceType == "ExpiryDisable" ? "calendar-x" : svc.ServiceType == "OrphanCleanup" ? "person-dash" : "database-fill-gear")"></i>
                            </div>
                            <div>
                                <h6 class="fw-700 mb-0">@svc.Name</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-xs text-muted">@(svc.ServiceType == "OrphanCleanup" ? $"{svc.SourceProvider} ↔ AD" : svc.ServiceType == "EmptyAttrDisable" || svc.ServiceType == "InactiveDisable" || svc.ServiceType == "AdAudit" || svc.ServiceType == "ExpiryDisable" ? "AD → AD" : $"{svc.SourceProvider} → AD")</span>
                                    <span class="badge fs-xs @(svc.ServiceType == "Offboarding" ? "bg-danger bg-opacity-25 text-danger" : svc.ServiceType == "EmptyAttrDisable" ? "bg-warning bg-opacity-25 text-warning" : svc.ServiceType == "InactiveDisable" ? "bg-danger bg-opacity-25 text-danger" : svc.ServiceType == "AdAudit" ? "bg-primary bg-opacity-25 text-primary" : svc.ServiceType == "ExpiryDisable" ? "bg-danger bg-opacity-25 text-danger" : svc.ServiceType == "OrphanCleanup" ? "bg-danger bg-opacity-25 text-danger" : "bg-info bg-opacity-25 text-info")">
                                        @(svc.ServiceType == "Offboarding" ? (isAr ? "إخلاء طرف" : "Offboarding")
                                            : svc.ServiceType == "EmptyAttrDisable" ? (isAr ? "تعطيل ناقصي البيانات" : "Empty-Attr Disable")
                                            : svc.ServiceType == "InactiveDisable" ? (isAr ? "تعطيل غير المستخدمة" : "Inactive Disable")
                                            : svc.ServiceType == "AdAudit" ? (isAr ? "تدقيق AD" : "AD Audit")
                                            : svc.ServiceType == "ExpiryDisable" ? (isAr ? "تنبيه الانتهاء" : "Expiry")
                                            : svc.ServiceType == "OrphanCleanup" ? (isAr ? "حسابات يتيمة" : "Orphaned")
                                            : (isAr ? "مزامنة" : "Sync"))
                                    </span>
                                </div>
                            </div>
                        </div>
                        @* Was read-only. Suspending a schedule needed opening the edit form and
                           saving, which is too slow for "stop this now" — before AD maintenance,
                           or a security scan. *@
                        <div class="form-check form-switch">
                            <input class="form-check-input svc-schedule-toggle" type="checkbox"
                                   data-id="@svc.Id" @(svc.IsEnabled ? "checked" : "")
                                   title="@(svc.IsEnabled ? (isAr ? "الجدولة تعمل — اضغط للإيقاف" : "Schedule running — click to suspend") : (isAr ? "الجدولة موقوفة — اضغط للاستئناف" : "Schedule suspended — click to resume"))">
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(svc.Description))
                    {
                        <p class="text-muted fs-sm mb-3">@svc.Description</p>
                    }

                    <!-- Source & Target Info -->
                    <div class="svc-info-grid mb-3">
                        <div class="svc-info-item">
                            <i class="bi bi-database text-info"></i>
                            <div>
                                <span class="fs-xs text-muted">@(isAr ? "المصدر" : "Source")</span>
                                <span class="fs-sm fw-600 d-block text-truncate" title="@svc.SourceTableOrView">@svc.SourceTableOrView</span>
                            </div>
                        </div>
                        <div class="svc-info-item">
                            <i class="bi bi-diagram-3 text-accent"></i>
                            <div>
                                <span class="fs-xs text-muted">@(isAr ? "البحث في AD" : "AD Search")</span>
                                <span class="fs-sm fw-600 d-block">@svc.ADSearchAttribute</span>
                            </div>
                        </div>
                    </div>

                    <!-- Mappings count -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-opacity-10 bg-info text-info">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            @svc.FieldMappings.Count @(isAr ? "ربط" : "Mappings")
                        </span>
                        @if (!string.IsNullOrEmpty(svc.ScheduleCron))
                        {
                            @* The cron description alone reads the same whether the job is
                               registered or not — that is how a schedule sits idle unnoticed. The
                               state is spelled out beside it. *@
                            <span class="badge bg-opacity-10 bg-warning text-warning">
                                <i class="bi bi-clock me-1"></i>
                                @IdentitySyncPro.Infrastructure.Services.CronBuilder.Describe(svc.ScheduleCron, isAr)
                            </span>
                            @if (svc.IsEnabled)
                            {
                                <span class="badge bg-opacity-10 bg-success text-success" data-schedule-state="@svc.Id">
                                    <i class="bi bi-check-circle me-1"></i>@(isAr ? "مجدولة" : "Scheduled")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-opacity-10 bg-danger text-danger" data-schedule-state="@svc.Id">
                                    <i class="bi bi-pause-circle me-1"></i>@(isAr ? "الجدولة موقوفة" : "Schedule suspended")
                                </span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-opacity-10 bg-secondary text-secondary">
                                <i class="bi bi-dash-circle me-1"></i>@(isAr ? "بلا جدولة" : "No schedule")
                            </span>
                        }
                    </div>

                    <!-- Last Run Status -->
                    <div class="d-flex align-items-center justify-content-between p-2 rounded mb-3" style="background: rgba(255,255,255,0.03);">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-@statusIcon text-@statusColor"></i>
                            <span class="fs-sm">@statusText</span>
                        </div>
                        @if (svc.LastRunAt.HasValue)
                        {
                            <span class="fs-xs text-muted">@svc.LastRunAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <form asp-action="RunNow" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@svc.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success flex-fill" title="@(isAr ? "تشغيل الآن" : "Run Now")">
                                <i class="bi bi-play-fill me-1"></i> @(isAr ? "تشغيل" : "Run")
                            </button>
                        </form>
                        <a href="@Url.Action("Edit", new { id = svc.Id })" class="btn btn-sm btn-outline-info flex-fill" title="@(isAr ? "تعديل" : "Edit")">
                            <i class="bi bi-pencil-fill me-1"></i> @(isAr ? "تعديل" : "Edit")
                        </a>
                        <a href="@Url.Action("Logs", new { id = svc.Id })" class="btn btn-sm btn-outline-warning flex-fill" title="@(isAr ? "السجل" : "Logs")">
                            <i class="bi bi-journal-text me-1"></i> @(isAr ? "السجل" : "Logs")
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('@(isAr ? "هل أنت متأكد من حذف هذه الخدمة؟" : "Are you sure you want to delete this service?")')">
                            <input type="hidden" name="id" value="@svc.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@(isAr ? "حذف" : "Delete")">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    // One-click suspend/resume of a service's schedule. The layout attaches the antiforgery
    // token to every non-GET fetch, so none is added here.
    //
    // The switch is reverted on failure rather than left showing the state the operator asked
    // for: a toggle that looks applied when it is not is exactly the confusion this feature is
    // meant to remove.
    // Serialized rather than interpolated: Razor HTML-encodes @@(...) and the HTML parser does not
    // decode entities inside <script>, so Arabic injected that way arrives as "&#x645;&#x648;…".
    // It happens to survive innerHTML (which does decode) and breaks anywhere else — alert(),
    // textContent. Serializing removes the difference.
    const svcL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        scheduled = isAr ? "مجدولة" : "Scheduled",
        suspended = isAr ? "الجدولة موقوفة" : "Schedule suspended",
        failed    = isAr ? "تعذّر تغيير حالة الجدولة — لم يتغيّر شيء" : "Could not change the schedule state — nothing was changed"
    }));

    document.querySelectorAll('.svc-schedule-toggle').forEach(function (el) {
        el.addEventListener('change', function () {
            var box = this;
            var id = box.dataset.id;
            var wanted = box.checked;
            box.disabled = true;

            var body = new FormData();
            body.append('id', id);

            fetch('@Url.Action("ToggleSchedule", "Services")', { method: 'POST', body: body })
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(function (d) {
                    if (!d.success) { throw new Error('rejected'); }
                    box.checked = d.enabled;

                    var badge = document.querySelector('[data-schedule-state="' + id + '"]');
                    if (badge) {
                        var on = d.scheduled;
                        badge.className = 'badge bg-opacity-10 ' + (on ? 'bg-success text-success' : 'bg-danger text-danger');
                        badge.innerHTML = (on ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-pause-circle me-1"></i>')
                                        + (on ? svcL.scheduled : svcL.suspended);
                    }
                })
                .catch(function () {
                    box.checked = !wanted;
                    alert(svcL.failed);
                })
                .finally(function () { box.disabled = false; });
        });
    });
</script>
<style>
    .svc-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .svc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    }
    .svc-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: white;
        flex-shrink: 0;
    }
    .svc-icon.disabled {
        background: rgba(100,100,100,0.3);
        opacity: 0.5;
    }
    .svc-icon.offboarding {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
    }
    .svc-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }
    .svc-info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.6rem;
        border-radius: 8px;
        background: rgba(255,255,255,0.02);
    }
    .svc-info-item i {
        font-size: 1.1rem;
        flex-shrink: 0;
    }
</style>
}
