            @if (Model.ServiceType == "OrphanCleanup")
            {
            <!-- Orphaned-Account Settings -->
            <div class="glass-card mb-3">
                <h6 class="fw-700 mb-3"><i class="bi bi-person-dash me-2 text-danger"></i> @(isAr ? "إعدادات الحسابات اليتيمة" : "Orphaned-Account Settings")</h6>
                <div class="alert alert-info py-2 px-3 fs-xs">
                    <i class="bi bi-info-circle me-1"></i>@(isAr
                        ? "يقرأ مفاتيح المصدر (قاعدة البيانات + عمود المفتاح أدناه) ويطابقها بحسابات AD. الحساب الذي يحمل سمة المفتاح ومفتاحه غير موجود في المصدر = يتيم."
                        : "Reads source keys (source DB + key column below) and matches them against AD. An account carrying the key attribute whose key is missing from the source = orphan.")}
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "الإجراء" : "Action") <span class="text-danger">*</span></label>
                        <select name="OrphanAction" id="orphanAction" class="form-select bg-transparent" onchange="onOrphanActionChange()">
                            <option value="Report" selected="@((Model.OrphanAction ?? "Report") == "Report")">@(isAr ? "تقرير فقط" : "Report only")</option>
                            <option value="Disable" selected="@(Model.OrphanAction == "Disable")">@(isAr ? "تعطيل في المكان" : "Disable in place")</option>
                            <option value="DisableAndMove" selected="@(Model.OrphanAction == "DisableAndMove")">@(isAr ? "تعطيل + نقل لـ OU حجر" : "Disable + move to quarantine OU")</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@(isAr ? "حدّ أمان المصدر" : "Source safety min")</label>
                        <input type="number" name="MinSourceRecords" class="form-control bg-transparent" value="@Model.MinSourceRecords" min="1" />
                        <div class="form-text">@(isAr ? "توقّف بلا إجراء إن رجع المصدر أقل من هذا" : "Abort if the source returns fewer than this")</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@(isAr ? "الـ OU المستهدفة للفحص" : "OU to Scan") <span class="text-danger">*</span></label>
                        <input type="text" name="OffboardingSearchOU" class="form-control bg-transparent" value="@Model.OffboardingSearchOU"
                               placeholder="@(isAr ? "مثال: OU=Users,DC=company,DC=com" : "e.g., OU=Users,DC=company,DC=com")" />
                        <div class="form-text text-warning">@(isAr ? "مطلوب — OU التي تديرها المزامنة" : "Required — the OU that sync manages")</div>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label">@(isAr ? "مجموعة الاستثناء" : "Exclusion group")</label>
                        <input type="text" name="OffboardingExclusionGroup" class="form-control bg-transparent" value="@Model.OffboardingExclusionGroup"
                               placeholder="@(isAr ? "break-glass / حسابات الخدمة" : "break-glass / service accounts")" />
                        <div class="form-text">@(isAr ? "مجموعة غير موجودة = توقّف الخدمة (حماية)" : "A missing group aborts the run (safety)")</div>
                    </div>
                    <div class="col-md-5" id="quarantineOuGroup" style="display:none">
                        <label class="form-label">@(isAr ? "OU الحجر (للنقل)" : "Quarantine OU (for move)") <span class="text-danger">*</span></label>
                        <input type="text" name="TargetOU" class="form-control bg-transparent" value="@Model.TargetOU" placeholder="OU=Orphaned,DC=company,DC=com" />
                    </div>
                </div>

                <hr class="my-4 opacity-10">
                <h6 class="fw-700 mb-3"><i class="bi bi-envelope-fill me-2 text-primary"></i> @(isAr ? "إشعار البريد للإدارة" : "Email to administration")</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" name="EnableEmailNotification" value="true" @(Model.EnableEmailNotification ? "checked" : "") id="chkEmailOrphan">
                            <input type="hidden" name="EnableEmailNotification" value="false" />
                            <label class="form-check-label" for="chkEmailOrphan">@(isAr ? "تفعيل إشعار البريد" : "Enable Email")</label>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@(isAr ? "البريد الإلكتروني" : "Notification Email")</label>
                        <input type="text" name="NotificationEmail" class="form-control bg-transparent" value="@Model.NotificationEmail" placeholder="security@company.com; it@company.com" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@(isAr ? "عنوان البريد" : "Email Subject")</label>
                        <input type="text" name="EmailSubject" class="form-control bg-transparent" value="@Model.EmailSubject"
                               placeholder="@(isAr ? "الحسابات اليتيمة — {COUNT} ({ACTION})" : "Orphaned accounts — {COUNT} ({ACTION})")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@(isAr ? "محتوى البريد (HTML)" : "Email Body (HTML)")</label>
                        <textarea name="EmailBodyTemplate" class="form-control bg-transparent" rows="3"
                                  placeholder="@(isAr ? "اتركه فارغاً للقالب الافتراضي" : "Leave empty to use default template")">@Model.EmailBodyTemplate</textarea>
                        <div class="form-text">@(isAr ? "المتغيرات: {COUNT}, {ACTION}, {ROWS}" : "Variables: {COUNT}, {ACTION}, {ROWS}")</div>
                    </div>
                </div>
            </div>
            }

            @if (Model.ServiceType != "EmptyAttrDisable" && Model.ServiceType != "InactiveDisable" && Model.ServiceType != "AdAudit" && Model.ServiceType != "ExpiryDisable")
            {
            <!-- Source Database -->
            <div class="glass-card mb-3">
                <h6 class="fw-700 mb-3"><i class="bi bi-database-fill me-2 text-info"></i> @(isAr ? "قاعدة البيانات المصدر" : "Source Database")</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">@(isAr ? "النوع" : "Provider")</label>
                        <select name="SourceProvider" class="form-select bg-transparent" id="sourceProvider">
                            <option value="SqlServer" selected="@(Model.SourceProvider == "SqlServer")">SQL Server</option>
                            <option value="Oracle" selected="@(Model.SourceProvider == "Oracle")">Oracle</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@(isAr ? "الخادم" : "Host")</label>
