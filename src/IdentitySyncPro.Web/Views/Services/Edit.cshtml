                <hr class="my-4 opacity-10">
                <h6 class="fw-700 mb-3"><i class="bi bi-envelope-fill me-2 text-primary"></i> @(isAr ? "إشعار البريد للإدارة (ملخّص)" : "Email to administration (summary)")</h6>
