                               placeholder="@(isAr ? "تنبيه انتهاء — تحذير: {WARNED} / تعطيل: {DISABLED}" : "Expiry — warned: {WARNED} / disabled: {DISABLED}")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@(isAr ? "محتوى البريد (HTML)" : "Email Body (HTML)")</label>
                        <textarea name="EmailBodyTemplate" class="form-control bg-transparent" rows="3"
                                  placeholder="@(isAr ? "اتركه فارغاً للقالب الافتراضي" : "Leave empty to use default template")">@Model.EmailBodyTemplate</textarea>
                        <div class="form-text">@(isAr ? "المتغيرات: {WARNED}, {DISABLED}, {WARN_TABLE}, {DISABLE_TABLE}" : "Variables: {WARNED}, {DISABLED}, {WARN_TABLE}, {DISABLE_TABLE}")</div>
                    </div>
                </div>
