                        <button type="button" class="btn btn-outline-info w-100" id="btnTestSrc">
                            <i class="bi bi-plug-fill me-1"></i> @(isAr ? "اختبار" : "Test")
                        </button>
                    </div>
                </div>
                <div id="srcTestResult" class="mt-2"></div>
            </div>
            }

            <!-- AD Target -->
            <div class="glass-card mb-3">
                <h6 class="fw-700 mb-3"><i class="bi bi-diagram-3-fill me-2 text-accent"></i> Active Directory</h6>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">@(isAr ? "الخادم" : "Server")</label>
                        <input type="text" name="ADServer" class="form-control bg-transparent" value="@Model.ADServer" id="adServer" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@(isAr ? "المنفذ" : "Port")</label>
                        <input type="number" name="ADPort" class="form-control bg-transparent" value="@Model.ADPort" id="adPort" />
                    </div>
                    @{
                        // Rows saved before the mode existed fall back to the legacy SSL switch.
                        var svcModeVal = Model.ADSecurityModeSet ? (int)Model.ADSecurityMode : (Model.ADUseSsl ? 2 : 1);
                    }
                    <div class="col-md-2">
                        <label class="form-label">@(isAr ? "تشفير القناة" : "Channel security")</label>
                        <select name="ADSecurityMode" id="adSecurityMode" class="form-control bg-transparent">
                            <option value="0" selected="@(svcModeVal == 0)">@(isAr ? "تلقائي" : "Auto")</option>
                            <option value="1" selected="@(svcModeVal == 1)">@(isAr ? "sign & seal (389)" : "Sign & seal (389)")</option>
                            <option value="2" selected="@(svcModeVal == 2)">@(isAr ? "LDAPS (636)" : "LDAPS (636)")</option>
                            <option value="3" selected="@(svcModeVal == 3)">StartTLS (389)</option>
                            <option value="4" selected="@(svcModeVal == 4)">@(isAr ? "بلا تشفير" : "No encryption")</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="ADAllowUntrustedCertificate" value="true" @(Model.ADAllowUntrustedCertificate ? "checked" : "") id="chkAdUntrusted">
                            <label class="form-check-label fs-sm" for="chkAdUntrusted">@(isAr ? "قبول شهادة غير موثوقة (CA داخلي / self-signed)" : "Accept untrusted certificate (internal CA / self-signed)")</label>
                        </div>
                        <div id="adModeHint" class="alert alert-secondary py-1 px-2 mb-0 mt-2 fs-xs"></div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-info w-100" id="btnTestAd">
                            <i class="bi bi-plug-fill me-1"></i> @(isAr ? "اختبار" : "Test")
                        </button>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "المستخدم" : "Username")</label>
                        <input type="text" name="ADUsername" class="form-control bg-transparent" value="@Model.ADUsername" id="adUsername" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "كلمة المرور" : "Password")</label>
                        <input type="password" name="ADPassword" class="form-control bg-transparent" placeholder="@(isAr ? "اتركه فارغاً لعدم التغيير" : "Leave empty to keep")" id="adPassword" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Base DN</label>
                        <input type="text" name="ADBaseDN" class="form-control bg-transparent" value="@Model.ADBaseDN" id="adBaseDN" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "خاصية البحث" : "Search Attribute")</label>
                        <input type="text" name="ADSearchAttribute" class="form-control bg-transparent" value="@Model.ADSearchAttribute" />
                    </div>
                </div>
                <div id="adTestResult" class="mt-2"></div>
            </div>

            <!-- Schedule -->
            <div class="glass-card mb-3">
                <h6 class="fw-700 mb-3"><i class="bi bi-clock-fill me-2 text-warning"></i> @(isAr ? "الجدولة" : "Schedule")</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">@(isAr ? "النوع" : "Mode")</label>
                        <select name="ScheduleMode" class="form-select bg-transparent" id="scheduleMode">
                            <option value="daily" selected="@(Model.ScheduleMode == "daily")">@(isAr ? "يومي" : "Daily")</option>
                            <option value="weekly" selected="@(Model.ScheduleMode == "weekly")">@(isAr ? "أسبوعي" : "Weekly")</option>
                            <option value="monthly" selected="@(Model.ScheduleMode == "monthly")">@(isAr ? "شهري" : "Monthly")</option>
                            <option value="interval" selected="@(Model.ScheduleMode == "interval")">@(isAr ? "فترة" : "Interval")</option>
                            <option value="custom" selected="@(Model.ScheduleMode == "custom")">@(isAr ? "مخصص" : "Custom")</option>
                        </select>
                    </div>
                    <div class="col-md-3" id="timeGroup">
                        <label class="form-label">@(isAr ? "الوقت" : "Time")</label>
                        <input type="time" name="ScheduleTime" class="form-control bg-transparent" value="@(Model.ScheduleTime ?? "02:00")" />
                    </div>
                    <div class="col-md-3" id="intervalGroup" style="display:none">
                        <label class="form-label">@(isAr ? "الفترة (دقائق)" : "Interval (min)")</label>
                        <input type="number" name="ScheduleIntervalMinutes" class="form-control bg-transparent" value="@(Model.ScheduleIntervalMinutes ?? 60)" min="5" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@(isAr ? "تعبير Cron الحالي" : "Current Cron")</label>
                        <input type="text" class="form-control bg-transparent text-muted" value="@(Model.ScheduleCron ?? "N/A")" readonly />
                    </div>
                </div>
                @* 1-28 only: cron cannot say "last day", so day 31 never fires in five months of
                   the year while the screen still shows a configured schedule. *@
                <div class="mt-3" id="dayOfMonthGroup" style="@(Model.ScheduleMode == "monthly" ? "" : "display:none")">
                    <label class="form-label">@(isAr ? "يوم الشهر" : "Day of month")</label>
                    <input type="number" name="ScheduleDayOfMonth" class="form-control bg-transparent"
                           value="@(Model.ScheduleDayOfMonth < 1 ? 1 : Model.ScheduleDayOfMonth)" min="1" max="28" style="max-width:200px" />
                    <div class="form-text">
                        @(isAr
                            ? "من 1 إلى 28. الأيام 29–31 لا توجد في كل الشهور فتُتخطّى تلك الشهور بالكامل — للتشغيل في نهاية الشهر استخدم «مخصص»."
                            : "1 to 28. Days 29-31 do not exist in every month and those months are skipped entirely — for a month-end run use \"Custom\".")
                    </div>
                </div>

                @* The field this mode never had. Without it "custom" silently became a daily schedule. *@
                <div class="mt-3" id="customCronGroup" style="@(Model.ScheduleMode == "custom" ? "" : "display:none")">
                    <label class="form-label">@(isAr ? "تعبير Cron" : "Cron expression")</label>
                    <input type="text" name="ScheduleCustomCron" class="form-control bg-transparent"
                           value="@Model.ScheduleCustomCron" placeholder="0 2 1 * *" dir="ltr" />
                    <div class="form-text">
                        @(isAr
                            ? "خمسة حقول: دقيقة ساعة يوم-الشهر شهر يوم-الأسبوع. مثال: 0 2 1 * * = الساعة 02:00 من أول كل شهر. التعبير الخاطئ يرفض الحفظ برسالة."
                            : "Five fields: minute hour day-of-month month day-of-week. Example: 0 2 1 * * = 02:00 on the 1st of each month. An invalid expression refuses the save with a reason.")
                    </div>
                </div>

                <div class="mt-3" id="daysGroup" style="@(Model.ScheduleMode == "weekly" ? "" : "display:none")">
                    <label class="form-label">@(isAr ? "الأيام" : "Days")</label>
                    <div class="d-flex flex-wrap gap-2">
                        @{
                            var dayNames = isAr
                                ? new[] { "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" }
                                : new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
                            var selectedDays = (Model.ScheduleDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        }
                        @for (int i = 0; i < 7; i++)
                        {
                            <label class="btn btn-outline-secondary btn-sm day-btn @(selectedDays.Contains(i.ToString()) ? "active-day" : "")">
                                <input type="checkbox" class="d-none day-checkbox" value="@i" @(selectedDays.Contains(i.ToString()) ? "checked" : "")> @dayNames[i]
                            </label>
                        }
                    </div>
                    <input type="hidden" name="ScheduleDays" id="scheduleDays" value="@Model.ScheduleDays" />
                </div>
            </div>

            <button type="submit" class="btn btn-accent btn-lg w-100">
                <i class="bi bi-check-lg me-1"></i> @(isAr ? "حفظ التغييرات" : "Save Changes")
            </button>
        </form>
    </div>

    <!-- Tab: Field Mapping -->
    <div class="tab-pane fade" id="tabMapping">
        <div class="glass-card mb-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-700 mb-0">
                    <i class="bi bi-arrow-left-right me-2 text-accent"></i>
                    @(isAr ? "ربط الأعمدة" : "Field Mapping")
                </h6>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-info btn-sm" id="btnFetchColumns">
                        <i class="bi bi-cloud-download me-1"></i> @(isAr ? "جلب الأعمدة" : "Fetch Columns")
                    </button>
                    <button class="btn btn-accent btn-sm" id="btnAddMapping">
                        <i class="bi bi-plus-lg me-1"></i> @(isAr ? "إضافة ربط" : "Add Mapping")
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table-glass w-100" id="mappingTable">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th>@(isAr ? "عمود المصدر" : "Source Column")</th>
                            <th>→</th>
                            <th>@(isAr ? "خاصية AD" : "AD Attribute")</th>
                            <th style="width:100px">@(isAr ? "مفتاح" : "Key")</th>
                            <th style="width:60px"></th>
                        </tr>
                    </thead>
                    <tbody id="mappingBody">
                        @foreach (var m in Model.FieldMappings)
                        {
                            <tr class="mapping-row">
                                <td class="row-num"></td>
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-transparent mapping-source" value="@m.SourceColumn"
                                           list="sourceColumnsList" />
                                </td>
                                <td class="text-center text-accent"><i class="bi bi-arrow-right"></i></td>
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-transparent mapping-target" value="@m.TargetAttribute"
                                           list="adAttributesList" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input mapping-key" @(m.IsKeyMapping ? "checked" : "") />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-mapping">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Common AD Attributes datalist -->
            <datalist id="adAttributesList">
                <option value="sAMAccountName"></option>
                <option value="userPrincipalName"></option>
                <option value="displayName"></option>
                <option value="givenName"></option>
                <option value="sn"></option>
                <option value="mail"></option>
                <option value="department"></option>
                <option value="title"></option>
                <option value="company"></option>
                <option value="telephoneNumber"></option>
                <option value="mobile"></option>
                <option value="physicalDeliveryOfficeName"></option>
                <option value="streetAddress"></option>
                <option value="l"></option>
                <option value="st"></option>
                <option value="postalCode"></option>
                <option value="co"></option>
                <option value="employeeID"></option>
                <option value="employeeNumber"></option>
                <option value="description"></option>
                <option value="info"></option>
                <option value="extensionAttribute1"></option>
                <option value="extensionAttribute2"></option>
                <option value="extensionAttribute3"></option>
                <option value="extensionAttribute4"></option>
                <option value="extensionAttribute5"></option>
                <option value="extensionAttribute6"></option>
                <option value="extensionAttribute7"></option>
                <option value="extensionAttribute8"></option>
                <option value="extensionAttribute9"></option>
                <option value="extensionAttribute10"></option>
                <option value="extensionAttribute11"></option>
                <option value="extensionAttribute12"></option>
                <option value="extensionAttribute13"></option>
                <option value="extensionAttribute14"></option>
                <option value="extensionAttribute15"></option>
            </datalist>
            <datalist id="sourceColumnsList"></datalist>

            <button class="btn btn-accent w-100 mt-3" id="btnSaveMappings">
                <i class="bi bi-save me-1"></i> @(isAr ? "حفظ ربط الأعمدة" : "Save Mappings")
            </button>
            <div id="mappingSaveResult" class="mt-2"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/ldap-mode-hint.js"></script>
<script>
    // Live explanation of the chosen AD channel mode + port.
    document.addEventListener('DOMContentLoaded', function () {
        bindLdapModeHint({ mode: 'adSecurityMode', port: 'adPort', hint: 'adModeHint', rtl: @(isAr ? "true" : "false") });
    });
</script>

<style>
    .glass-tabs .nav-link {
        color: var(--text-secondary);
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        transition: all 0.3s;
    }
    .glass-tabs .nav-link.active {
        color: white;
        background: rgba(99,102,241,0.15);
        border-color: var(--accent);
    }
    .day-btn.active-day {
        background: var(--accent) !important;
        border-color: var(--accent) !important;
        color: white !important;
    }
    .mapping-row td { vertical-align: middle; }
</style>
<script>
    // Schedule mode toggle
    const scheduleMode = document.getElementById('scheduleMode');
    function updateScheduleUI() {
        const mode = scheduleMode.value;
        document.getElementById('timeGroup').style.display = (mode === 'daily' || mode === 'weekly' || mode === 'monthly') ? '' : 'none';
        document.getElementById('intervalGroup').style.display = mode === 'interval' ? '' : 'none';
        document.getElementById('daysGroup').style.display = mode === 'weekly' ? '' : 'none';
        document.getElementById('dayOfMonthGroup').style.display = mode === 'monthly' ? '' : 'none';
        document.getElementById('customCronGroup').style.display = mode === 'custom' ? '' : 'none';
    }
    scheduleMode.addEventListener('change', updateScheduleUI);
    updateScheduleUI();

    // SMS toggle visibility (matching Create behavior)
    const chkSmsEdit = document.getElementById('chkSmsEdit');
    function toggleSmsEditFields() {
        const show = chkSmsEdit.checked;
        document.getElementById('phoneColGroupEdit').style.display = show ? '' : 'none';
        document.getElementById('smsProviderGroupEdit').style.display = show ? '' : 'none';
        document.getElementById('smsTemplateGroupEdit').style.display = show ? '' : 'none';
    }
    if (chkSmsEdit) {
        chkSmsEdit.addEventListener('change', toggleSmsEditFields);
        toggleSmsEditFields();
    }

    // Day checkboxes
    document.querySelectorAll('.day-checkbox').forEach(cb => {
        cb.addEventListener('change', function() {
            this.closest('.day-btn').classList.toggle('active-day', this.checked);
            const selected = [...document.querySelectorAll('.day-checkbox:checked')].map(c => c.value);
            document.getElementById('scheduleDays').value = selected.join(',');
        });
    });

    // Mapping: add row
    let rowCounter = document.querySelectorAll('.mapping-row').length;
    document.getElementById('btnAddMapping').addEventListener('click', () => {
        rowCounter++;
        const row = document.createElement('tr');
        row.className = 'mapping-row';
        row.innerHTML = `
            <td class="row-num">${rowCounter}</td>
            <td><input type="text" class="form-control form-control-sm bg-transparent mapping-source" list="sourceColumnsList" /></td>
            <td class="text-center text-accent"><i class="bi bi-arrow-right"></i></td>
            <td><input type="text" class="form-control form-control-sm bg-transparent mapping-target" list="adAttributesList" /></td>
            <td class="text-center"><input type="checkbox" class="form-check-input mapping-key" /></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-mapping"><i class="bi bi-trash"></i></button></td>
        `;
        document.getElementById('mappingBody').appendChild(row);
        updateRowNumbers();
    });

    // Mapping: remove row
    document.getElementById('mappingBody').addEventListener('click', (e) => {
        if (e.target.closest('.btn-remove-mapping')) {
            e.target.closest('.mapping-row').remove();
            updateRowNumbers();
        }
    });

    function updateRowNumbers() {
        document.querySelectorAll('.mapping-row .row-num').forEach((td, i) => td.textContent = i + 1);
    }
    updateRowNumbers();

    // Fetch source columns
    document.getElementById('btnFetchColumns').addEventListener('click', async () => {
        const btn = document.getElementById('btnFetchColumns');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';

        try {
            const formData = new FormData();
            formData.append('provider', document.getElementById('sourceProvider').value);
            formData.append('host', document.getElementById('srcHost').value);
            formData.append('port', document.getElementById('srcPort').value);
            formData.append('database', document.getElementById('srcDatabase').value);
            formData.append('username', document.getElementById('srcUsername').value);
            formData.append('password', document.getElementById('srcPassword').value);
            formData.append('integratedSecurity', document.getElementById('chkIntegrated').checked);
            formData.append('tableOrView', document.getElementById('srcView').value);

            const res = await fetch('@Url.Action("GetSourceColumns")', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                const dl = document.getElementById('sourceColumnsList');
                dl.innerHTML = '';
                data.columns.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    dl.appendChild(opt);
                });
                showToast(`@(isAr ? "تم جلب" : "Fetched") ${data.columns.length} @(isAr ? "عمود" : "columns")`, 'success');
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast(e.message, 'error');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cloud-download me-1"></i> @(isAr ? "جلب الأعمدة" : "Fetch Columns")';
    });

    // Save mappings
    document.getElementById('btnSaveMappings').addEventListener('click', async () => {
        const btn = document.getElementById('btnSaveMappings');
        const resultDiv = document.getElementById('mappingSaveResult');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> @(isAr ? "جاري الحفظ..." : "Saving...")';

        try {
            const rows = document.querySelectorAll('.mapping-row');
            const mappings = [];
            rows.forEach(row => {
                const src = row.querySelector('.mapping-source').value.trim();
                const tgt = row.querySelector('.mapping-target').value.trim();
                const isKey = row.querySelector('.mapping-key').checked;
                if (src && tgt) mappings.push({ sourceColumn: src, targetAttribute: tgt, isKeyMapping: isKey });
            });

            const res = await fetch('@Url.Action("SaveMappings")' + '?serviceId=@Model.Id', {
                method: 'POST',
                body: JSON.stringify(mappings),
                headers: { 'Content-Type': 'application/json' }
            });

            if (!res.ok) {
                resultDiv.innerHTML = `<div class="alert alert-danger py-2 fs-sm"><i class="bi bi-x-circle-fill me-1"></i> HTTP ${res.status}: ${res.statusText}</div>`;
                return;
            }

            const data = await res.json();
            resultDiv.innerHTML = data.success
                ? `<div class="alert alert-success py-2 fs-sm"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</div>`
                : `<div class="alert alert-danger py-2 fs-sm"><i class="bi bi-x-circle-fill me-1"></i> ${data.message}</div>`;
        } catch (e) {
            resultDiv.innerHTML = `<div class="alert alert-danger py-2 fs-sm"><i class="bi bi-x-circle-fill me-1"></i> Error: ${e.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-save me-1"></i> @(isAr ? "حفظ ربط الأعمدة" : "Save Mappings")';
        }
    });

    // Run Now button (outside form to avoid nesting)
    document.getElementById('btnRunNow')?.addEventListener('click', async () => {
        const token = document.querySelector('[name=__RequestVerificationToken]').value;
        const formData = new URLSearchParams();
        formData.append('id', '@Model.Id');
        formData.append('__RequestVerificationToken', token);
        const res = await fetch('@Url.Action("RunNow")', { method: 'POST', body: formData, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } });
        if (res.redirected) { window.location.href = res.url; } else { window.location.href = '@Url.Action("Logs", new { id = Model.Id })'; }
    });

    // Test Source
    document.getElementById('btnTestSrc')?.addEventListener('click', async () => {
        const btn = document.getElementById('btnTestSrc');
        const resultDiv = document.getElementById('srcTestResult');
        btn.disabled = true;
        const formData = new FormData();
        formData.append('provider', document.getElementById('sourceProvider').value);
        formData.append('host', document.getElementById('srcHost').value);
        formData.append('port', document.getElementById('srcPort').value);
        formData.append('database', document.getElementById('srcDatabase').value);
        formData.append('username', document.getElementById('srcUsername').value);
        formData.append('password', document.getElementById('srcPassword').value);
        formData.append('integratedSecurity', document.getElementById('chkIntegrated').checked);
        const res = await fetch('@Url.Action("TestConnection")', { method: 'POST', body: formData });
        const data = await res.json();
        resultDiv.innerHTML = data.success
            ? `<div class="alert alert-success py-2 fs-sm"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</div>`
            : `<div class="alert alert-danger py-2 fs-sm"><i class="bi bi-x-circle-fill me-1"></i> ${data.message}</div>`;
        btn.disabled = false;
    });

    // Orphan: show the quarantine OU only for the move action
    function onOrphanActionChange() {
        const a = document.getElementById('orphanAction');
        const q = document.getElementById('quarantineOuGroup');
        if (a && q) q.style.display = a.value === 'DisableAndMove' ? '' : 'none';
    }
    onOrphanActionChange();

    // AD Audit: show only the config relevant to the chosen report type
    function onReportTypeChange() {
        const rt = document.getElementById('reportType');
        if (!rt) return;
        const isNhi = rt.value === 'NonHumanInventory';
        // The inventory needs the groups field too, but for the opposite purpose: not what to
        // list, but what counts as privileged among the accounts it finds.
        const needsGroups = rt.value === 'PrivilegedGroups' || rt.value === 'AccessCertification' || isNhi;
        const needsDup = rt.value === 'DuplicateAccounts';
        const isPwd = rt.value === 'PasswordNeverExpires';
        const g = document.getElementById('auditGroupsGroup');
        const d = document.getElementById('duplicateAttrGroup');
        const p = document.getElementById('pwdActionGroup');
        const n = document.getElementById('nhiGroup');
        const gh = document.getElementById('nhiGroupsHint');
        if (g) g.style.display = needsGroups ? '' : 'none';
        if (d) d.style.display = needsDup ? '' : 'none';
        if (p) p.style.display = isPwd ? '' : 'none';
        if (n) n.style.display = isNhi ? '' : 'none';
        if (gh) gh.style.display = isNhi ? '' : 'none';
        onPwdActionChange();
        onNhiLifecycleChange();
    }

    // The lifecycle settings appear only once it is switched on, and the warning only once the mode
    // chosen actually writes to the directory.
    //
    // Lives inside this view's ONE Scripts section. A second @@section with the same name compiles
    // without a word and throws "Section 'Scripts' is already defined" the first time the page is
    // rendered — which is how the settings screen was lost for a while.
    function onNhiLifecycleChange() {
        const on = document.getElementById('nhiLifecycle');
        const fields = document.getElementById('nhiLifecycleFields');
        const mode = document.getElementById('nhiQuarantineMode');
        const warn = document.getElementById('nhiEnforceWarning');

        const enabled = !!(on && on.checked);
        if (fields) fields.style.display = enabled ? '' : 'none';
        if (warn) warn.style.display = (enabled && mode && mode.value !== 'Report') ? '' : 'none';
    }

    // The removal warning and the exclusion field only appear once "Remove" is chosen.
    function onPwdActionChange() {
        const rt = document.getElementById('reportType');
        const sel = document.getElementById('pwdNeverExpiresAction');
        const warn = document.getElementById('pwdRemoveWarning');
        const excl = document.getElementById('pwdExclusionGroup');
        const removing = rt && sel && rt.value === 'PasswordNeverExpires' && sel.value === 'Remove';
        if (warn) warn.style.display = removing ? '' : 'none';
        if (excl) excl.style.display = removing ? '' : 'none';
    }
    onReportTypeChange();

    // Load SMS providers
    async function loadSmsProviders() {
        try {
            const res = await fetch('/SmsCenter/GetProviders');
            const data = await res.json();
            const sel = document.getElementById('smsProviderSelect');
            if (!sel) return;
            const currentId = '@(Model.SmsProviderId?.ToString() ?? "")';
            data.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id; opt.textContent = p.name + (p.senderName ? ' (' + p.senderName + ')' : '');
                if (p.id.toString() === currentId) opt.selected = true;
                sel.appendChild(opt);
            });
        } catch (e) { /* ignore */ }
    }
    loadSmsProviders();

    // Test AD
    document.getElementById('btnTestAd')?.addEventListener('click', async () => {
        const btn = document.getElementById('btnTestAd');
        const resultDiv = document.getElementById('adTestResult');
        btn.disabled = true;
        const formData = new FormData();
        formData.append('server', document.getElementById('adServer').value);
        formData.append('port', document.getElementById('adPort').value);
        formData.append('securityMode', document.getElementById('adSecurityMode').value);
        formData.append('allowUntrustedCertificate', document.getElementById('chkAdUntrusted').checked);
        formData.append('username', document.getElementById('adUsername').value);
        formData.append('password', document.getElementById('adPassword').value);
        formData.append('baseDN', document.getElementById('adBaseDN').value);
        const res = await fetch('@Url.Action("TestAdConnection")', { method: 'POST', body: formData });
        const data = await res.json();
        resultDiv.innerHTML = data.success
            ? `<div class="alert alert-success py-2 fs-sm"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</div>`
            : `<div class="alert alert-danger py-2 fs-sm"><i class="bi bi-x-circle-fill me-1"></i> ${data.message}</div>`;
        btn.disabled = false;
    });
</script>
}
