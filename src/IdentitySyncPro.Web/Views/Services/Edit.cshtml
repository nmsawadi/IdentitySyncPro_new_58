                        <input type="text" name="SourceDatabase" class="form-control bg-transparent" value="@Model.SourceDatabase" id="srcDatabase" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "المستخدم" : "Username")</label>
                        <input type="text" name="SourceUsername" class="form-control bg-transparent" value="@Model.SourceUsername" id="srcUsername" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "كلمة المرور" : "Password")</label>
                        <input type="password" name="SourcePassword" class="form-control bg-transparent" placeholder="@(isAr ? "اتركه فارغاً لعدم التغيير" : "Leave empty to keep")" id="srcPassword" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@(isAr ? "الفيو / الجدول" : "View / Table")</label>
                        <input type="text" name="SourceTableOrView" class="form-control bg-transparent" value="@Model.SourceTableOrView" id="srcView" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@(isAr ? "عمود المفتاح" : "Key Column")</label>
                        <input type="text" name="KeySourceColumn" class="form-control bg-transparent" value="@Model.KeySourceColumn" />
                    </div>
