                        <div class="form-text">@(isAr ? "المتغيرات: {SAM_ACCOUNT}, {DISPLAY_NAME}, {DAYS}, {EXPIRY_DATE}" : "Variables: {SAM_ACCOUNT}, {DISPLAY_NAME}, {DAYS}, {EXPIRY_DATE}")</div>
                    </div>
