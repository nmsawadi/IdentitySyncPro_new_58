                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@(isAr ? "المنفذ" : "Port")</label>
                        <input type="number" name="SourcePort" class="form-control bg-transparent" value="@Model.SourcePort" id="srcPort" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check form-switch mt-4" id="integratedSecurityGroup">
                            <input class="form-check-input" type="checkbox" name="SourceIntegratedSecurity" value="true"
                                   @(Model.SourceIntegratedSecurity ? "checked" : "") id="chkIntegrated">
                            <label class="form-check-label" for="chkIntegrated">@(isAr ? "Win Auth" : "Win Auth")</label>
                        </div>
                    </div>
                    <div class="col-md-4">
