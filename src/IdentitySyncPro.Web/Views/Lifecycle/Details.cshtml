@model IdentitySyncPro.Core.Models.Metaverse.MetaverseEntry
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? $"دورة الحياة: {Model.ExternalId}" : $"Lifecycle: {Model.ExternalId}";
    var attrs = Model.GetAttributes();
    var stateClass = Model.LifecycleState switch
    {
        "Active" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Suspended" => "bg-danger",
        "Deprovisioned" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<a href="@Url.Action("Index", "Lifecycle")" class="btn btn-glass btn-sm mb-3">
    <i class="bi bi-arrow-left me-1"></i> @(isAr ? "العودة لإدارة دورة الحياة" : "Back to Lifecycle Management")
</a>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="glass-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div style="width:56px;height:56px;border-radius:var(--radius-md);background:var(--accent-gradient);display:flex;align-items:center;justify-content:center;font-size:24px;color:white">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-600">@Model.ExternalId</h5>
                    <span class="badge @stateClass">@Model.LifecycleState</span>
                    <small class="text-muted ms-2">@Model.IdentityType</small>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "الحالة في المصدر" : "Source Status")</span>
                    <span>@Model.SourceStatusCode <small class="text-muted">(@(Model.SourceStatusDesc ?? "—"))</small></span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "الحالة السابقة" : "Previous State")</span>
                    <span>@(Model.PreviousState ?? "—")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "آخر تغيير للحالة" : "State Changed")</span>
                    <span class="fs-sm">@Model.StateChangedDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "حساب AD" : "AD Account")</span>
                    <span>@Html.Raw(Model.ADAccountEnabled
                        ? $"<i class='bi bi-check-circle-fill text-success'></i> {(isAr ? "مفعل" : "Enabled")}"
                        : $"<i class='bi bi-x-circle text-muted'></i> {(isAr ? "معطل" : "Disabled")}")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ADDistinguishedName))
                {
                    <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                        <span class="text-muted fs-sm">DN</span>
                        <span class="fs-xs text-end" style="max-width:60%;word-break:break-all;direction:ltr">@Model.ADDistinguishedName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ADCurrentOU))
                {
                    <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                        <span class="text-muted fs-sm">OU</span>
                        <span class="fs-xs text-end" style="max-width:60%;word-break:break-all;direction:ltr">@Model.ADCurrentOU</span>
                    </div>
                }
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "أول ظهور" : "First Seen")</span>
                    <span class="fs-sm">@Model.FirstSeenDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                    <span class="text-muted fs-sm">@(isAr ? "آخر استيراد" : "Last Import")</span>
                    <span class="fs-sm">@Model.LastImportDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                @if (Model.LastExportDate.HasValue)
                {
                    <div class="d-flex justify-content-between border-bottom pb-2" style="border-color:var(--border-color)!important">
                        <span class="text-muted fs-sm">@(isAr ? "آخر تصدير" : "Last Export")</span>
                        <span class="fs-sm">@Model.LastExportDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                }
            </div>

            <div class="mt-4 d-flex gap-2" id="lifecycleActions">
                <button class="btn btn-glow btn-sm" onclick="processIdentity(this, @Model.ExternalId, false)">
                    <i class="bi bi-arrow-repeat me-1"></i> @(isAr ? "معالجة دورة الحياة" : "Process Lifecycle")
                </button>
                <button class="btn btn-outline-warning btn-sm" onclick="processIdentity(this, @Model.ExternalId, true)">
                    <i class="bi bi-eye me-1"></i> @(isAr ? "محاكاة" : "Dry Run")
                </button>
            </div>
        </div>

        @if (attrs.Count > 0)
        {
            <div class="glass-card mt-4">
                <h6 class="fw-600 mb-3"><i class="bi bi-diagram-3 me-2 text-accent"></i>@(isAr ? "السمات المجمّعة" : "Consolidated Attributes")</h6>
                <div class="d-flex flex-column gap-2" style="max-height:300px;overflow-y:auto">
                    @foreach (var attr in attrs.Take(30))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-1" style="border-color:var(--border-color)!important">
                            <span class="text-muted fs-xs">@attr.Key</span>
                            <span class="fs-xs text-end" style="max-width:60%;word-break:break-all">@(attr.Value?.ToString() ?? "—")</span>
                        </div>
                    }
                    @if (attrs.Count > 30)
                    {
                        <div class="text-center text-muted fs-xs mt-1">... @(attrs.Count - 30) @(isAr ? "خاصية إضافية" : "more attributes")</div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-7">
        <div class="glass-card">
            <h6 class="fw-600 mb-3"><i class="bi bi-clock-history me-2 text-accent"></i>@(isAr ? "سجل التغييرات" : "History")</h6>
            @if (Model.History.Count > 0)
            {
                <table class="table-glass">
                    <thead>
                        <tr>
                            <th>@(isAr ? "الوقت" : "Time")</th>
                            <th>@(isAr ? "النوع" : "Type")</th>
                            <th>@(isAr ? "من" : "From")</th>
                            <th>@(isAr ? "إلى" : "To")</th>
                            <th>@(isAr ? "التفاصيل" : "Details")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td class="fs-sm text-muted">@h.Timestamp.ToString("MMM dd HH:mm")</td>
                                <td>
                                    <span class="badge-status @(h.ChangeType == "StateChange" ? "badge-warning"
                                        : h.ChangeType == "Import" ? "badge-info"
                                        : h.ChangeType == "Export" ? "badge-success"
                                        : "badge-secondary")">@h.ChangeType</span>
                                </td>
                                <td class="fs-sm">@(h.OldState ?? "—")</td>
                                <td class="fs-sm">@(h.NewState ?? "—")</td>
                                <td class="fs-xs text-muted" style="max-width:200px;word-break:break-word">@(h.Details ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-inbox"></i><p>@(isAr ? "لا يوجد سجل تغييرات لهذه الهوية." : "No history recorded for this identity.")</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function processIdentity(btn, identityId, dryRun) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> @(isAr ? "جارٍ المعالجة..." : "Processing...")';
        try {
            const res = await fetch('@Url.Action("ProcessIdentity")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `identityId=${identityId}&dryRun=${dryRun}`
            });
            const data = await res.json();
            if (data.success) {
                showToast(isRtl ? 'تمت المعالجة بنجاح' : 'Processed successfully', 'success');
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(data.error || 'Failed', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> @(isAr ? "معالجة" : "Process")';
            }
        } catch (e) {
            console.error('ProcessIdentity error:', e);
            showToast('Request failed', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> @(isAr ? "معالجة" : "Process")';
        }
    }
</script>
}
