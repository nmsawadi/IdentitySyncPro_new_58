@using IdentitySyncPro.Core.Helpers
@using IdentitySyncPro.Core.Models.Governance
@{
    var isAr = (ViewBag.Lang as string ?? "ar") == "ar";
    ViewData["Title"] = isAr ? "حساباتي غير البشرية" : "My Non-Human Accounts";

    var accounts = ViewBag.Accounts as List<GovNhiAccount> ?? new();
    var configs = ViewBag.Configs as Dictionary<int, NhiLifecyclePolicy.LifecycleConfig> ?? new();
    var now = (DateTime)(ViewBag.Now ?? DateTime.UtcNow);
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-700 mb-1">
            <i class="bi bi-robot me-2 text-accent"></i>@(isAr ? "حساباتي غير البشرية" : "My Non-Human Accounts")
        </h5>
        <p class="text-muted fs-sm mb-0">
            @(isAr
                ? "حسابات خدمة وبوتات أنت المسؤول عنها — أكّد أنها ما زالت لازمة، أو أعِدها"
                : "Service accounts and bots you are answerable for — confirm they are still needed, or hand them back")
        </p>
    </div>
    <a href="@Url.Action("Unclaimed")" class="btn btn-glass">
        <i class="bi bi-search me-1"></i>@(isAr ? "حسابات بلا مالك" : "Unclaimed accounts")
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-card border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (accounts.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <p class="text-muted mb-3">
            @(isAr ? "لا حساب غير بشري مسجَّل باسمك." : "No non-human account is recorded in your name.")
        </p>
        <a href="@Url.Action("Unclaimed")" class="btn btn-accent">
            <i class="bi bi-search me-1"></i>@(isAr ? "استعرض الحسابات بلا مالك" : "Browse unclaimed accounts")
        </a>
    </div>
}
else
{
    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@(isAr ? "الحساب" : "Account")</th>
                        <th>@(isAr ? "الحالة" : "State")</th>
                        <th>@(isAr ? "آخر إقرار" : "Last attested")</th>
                        <th>@(isAr ? "الإقرار القادم" : "Next attestation")</th>
                        <th class="text-end">@(isAr ? "الإجراء" : "Action")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in accounts)
                {
                    var cfg = configs.TryGetValue(a.ServiceId, out var c)
                        ? c
                        : new NhiLifecyclePolicy.LifecycleConfig(true, 30, 180, 14, GovNhiEnforcement.Report, 20);

                    var due = NhiLifecyclePolicy.AttestationDue(a, cfg);
                    var verdict = NhiLifecyclePolicy.Evaluate(a, cfg, now);
                    var overdue = verdict.AttestationOverdue;

                    <tr class="@(overdue ? "table-warning-subtle" : "")">
                        <td>
                            <div class="fw-600">@a.Account</div>
                            @if (!string.IsNullOrWhiteSpace(a.DisplayName) && a.DisplayName != a.Account)
                            {
                                <div class="fs-sm text-muted">@a.DisplayName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.Description))
                            {
                                <div class="fs-sm text-muted">@a.Description</div>
                            }
                        </td>
                        <td><partial name="_NhiState" model="a" /></td>
                        <td class="fs-sm">
                            @if (a.LastAttestedUtc is { } last)
                            {
                                <span>@last.ToString("yyyy-MM-dd")</span>
                                @if (!string.IsNullOrWhiteSpace(a.AttestationNote))
                                {
                                    <div class="text-muted">@a.AttestationNote</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">@(isAr ? "—" : "—")</span>
                            }
                        </td>
                        <td class="fs-sm">
                            @if (due is { } d)
                            {
                                <span class="@(overdue ? "text-danger fw-600" : "")">@d.ToString("yyyy-MM-dd")</span>
                                @if (overdue)
                                {
                                    @* The grace window is stated, not implied: the reader needs to know
                                       how long they have before the account is taken. *@
                                    <div class="text-danger">
                                        @(isAr
                                            ? $"فات موعده — أمامك {cfg.GraceDays} يوماً قبل الحجر"
                                            : $"overdue — {cfg.GraceDays} day(s) before quarantine")
                                    </div>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                <button type="button" class="btn btn-sm btn-accent"
                                        data-bs-toggle="modal" data-bs-target="#attest-@a.Id">
                                    <i class="bi bi-check2-square me-1"></i>@(isAr ? "أقرّ" : "Attest")
                                </button>
                                <form method="post" action="@Url.Action("Release")" class="d-inline"
                                      onsubmit="return confirm('@(isAr ? "سيعود الحساب بلا مالك، وتبقى مهلته الأصلية كما هي. متابعة؟" : "The account will have no owner again, and its original deadline still stands. Continue?")');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-glass">
                                        <i class="bi bi-person-dash me-1"></i>@(isAr ? "أعِده" : "Release")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var a in accounts)
    {
        <div class="modal fade" id="attest-@a.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" action="@Url.Action("Attest")" class="modal-content glass-card">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@a.Id" />
                    <div class="modal-header border-0">
                        <h6 class="modal-title fw-700">
                            <i class="bi bi-check2-square me-2 text-accent"></i>@(isAr ? "إقرار" : "Attest") — @a.Account
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="fs-sm text-muted">
                            @(isAr
                                ? "أنت تؤكّد أن هذا الحساب ما زال لازماً وأنك المسؤول عنه."
                                : "You are confirming this account is still needed and that you are answerable for it.")
                        </p>
                        <label class="form-label fs-sm">@(isAr ? "ملاحظة (اختيارية)" : "Note (optional)")</label>
                        <textarea name="note" rows="3" class="form-control"
                                  placeholder="@(isAr ? "لماذا هذا الحساب لازم — يقرأها من يراجع بعدك" : "Why this account is needed — whoever reviews it next will read this")"></textarea>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">@(isAr ? "إلغاء" : "Cancel")</button>
                        <button type="submit" class="btn btn-accent">@(isAr ? "أقرّ" : "Attest")</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
