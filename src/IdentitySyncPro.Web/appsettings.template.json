{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=IdentitySyncProDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Network": {
    "UseForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "SyncSettings": {
    "DefaultBatchSize": 1000,
    "SqlCommandTimeoutSeconds": 180,
    "LdapTimeoutSeconds": 0,
    "FullSyncSchedule": "0 2 * * *",
    "DeltaSyncSchedule": "*/30 * * * *",
    "HealthCheckSchedule": "*/10 * * * *",
    "EnableAutoSync": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identitysync-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identitysync-json-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiSecurity": {
    "ApiKey": "CHANGE-THIS-API-KEY",
    "HangfireApiKey": "CHANGE-THIS-HANGFIRE-KEY"
  },
  "Security": {
    "IdleTimeoutMinutes": 10,
    "RequireHttpsCookie": true,
    "EnableSecurityHeaders": true,
    "ContentSecurityPolicyReportOnly": false,
    "CspExtraHosts": "",
    "PasswordMaxAgeDays": 90,
    "DefaultAdminUsername": "isp-admin",
    "DefaultAdminPassword": ""
  },
  "AllowedHosts": "*"
}
